---
interface Props {
  title: string;
  description: string;
  href?: string;
  className?: string;
}

const { title, description, href, className = '' } = Astro.props;
---
<div class={`group relative bg-white rounded-xl shadow-sm border border-slate-100 p-6 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 ${className}`}>
  <h3 class="text-xl font-heading font-semibold text-slate-900 mb-3 group-hover:text-primary transition-colors">
    {href ? <a href={href} class="focus:outline-none"><span class="absolute inset-0" aria-hidden="true"></span>{title}</a> : title}
  </h3>
  <p class="text-slate-600 line-clamp-3">
    {description}
  </p>
  <slot />
</div>
