---
---

<footer class="relative bg-[#000511] text-white pt-24 pb-8 w-full overflow-hidden border-t border-[#1d4ed8]/20 shadow-[0_-20px_50px_rgba(29,78,216,0.05)]">
  
  <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[#1d4ed8] to-transparent opacity-50"></div>

  <div class="absolute -top-[300px] left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-[#1d4ed8] rounded-[100%] blur-[120px] opacity-10 pointer-events-none"></div>

  <div class="max-w-[1600px] mx-auto px-6 relative z-10">
    
    <div class="flex flex-col lg:flex-row justify-between items-start gap-16 mb-24">
      
      <div class="lg:w-1/3">
        <h3 class="text-3xl font-light text-white mb-6">Redefining <span class="text-[#1d4ed8] font-semibold">Risk</span></h3>
        <p class="text-sm font-light leading-relaxed text-gray-400 mb-8 max-w-sm">
          We transform raw satellite radar data into actionable, millimeter-accurate ground deformation intelligence. Stay ahead of the curve.
        </p>
        <a href="/contact" class="group relative inline-flex items-center gap-4 px-8 py-4 bg-transparent border border-[#1d4ed8] overflow-hidden transition-all duration-500 hover:border-transparent">
          <div class="absolute inset-0 bg-[#1d4ed8] translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-in-out"></div>
          <span class="relative z-10 text-xs font-semibold uppercase tracking-widest text-[#1d4ed8] group-hover:text-white transition-colors duration-500">Engage With Us</span>
          <i class="bx bx-right-arrow-alt relative z-10 text-xl text-[#1d4ed8] group-hover:text-white group-hover:translate-x-1 transition-all duration-500"></i>
        </a>
      </div>

      <div class="lg:w-2/3 grid grid-cols-1 md:grid-cols-3 gap-12">
        
        <div>
          <h4 class="text-xs font-semibold mb-6 uppercase tracking-widest text-gray-500">Solutions</h4>
          <ul class="space-y-4">
            <li><a href="/industries/mining" class="group text-sm font-light text-gray-300 hover:text-white transition-colors flex items-center gap-2"><span class="w-2 h-[1px] bg-[#1d4ed8] transition-all group-hover:w-4"></span> Mining</a></li>
            <li><a href="/industries/infrastructure" class="group text-sm font-light text-gray-300 hover:text-white transition-colors flex items-center gap-2"><span class="w-2 h-[1px] bg-[#1d4ed8] transition-all group-hover:w-4"></span> Infrastructure</a></li>
            <li><a href="/industries/energy" class="group text-sm font-light text-gray-300 hover:text-white transition-colors flex items-center gap-2"><span class="w-2 h-[1px] bg-[#1d4ed8] transition-all group-hover:w-4"></span> Energy</a></li>
            <li><a href="/industries/urban-development" class="group text-sm font-light text-gray-300 hover:text-white transition-colors flex items-center gap-2"><span class="w-2 h-[1px] bg-[#1d4ed8] transition-all group-hover:w-4"></span> Urban Dev</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-semibold mb-6 uppercase tracking-widest text-gray-500">Company</h4>
          <ul class="space-y-4">
            <li><a href="/about" class="group text-sm font-light text-gray-300 hover:text-white transition-colors flex items-center gap-2"><span class="w-2 h-[1px] bg-[#1d4ed8] transition-all group-hover:w-4"></span> About Us</a></li>
            <li><a href="/technology" class="group text-sm font-light text-gray-300 hover:text-white transition-colors flex items-center gap-2"><span class="w-2 h-[1px] bg-[#1d4ed8] transition-all group-hover:w-4"></span> Technology</a></li>
            <li><a href="/blog" class="group text-sm font-light text-gray-300 hover:text-white transition-colors flex items-center gap-2"><span class="w-2 h-[1px] bg-[#1d4ed8] transition-all group-hover:w-4"></span> Intelligence</a></li>
            <li><a href="/careers" class="group text-sm font-light text-gray-300 hover:text-white transition-colors flex items-center gap-2"><span class="w-2 h-[1px] bg-[#1d4ed8] transition-all group-hover:w-4"></span> Careers</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-semibold mb-6 tracking-widest uppercase text-gray-500">Connect</h4>
          <p class="text-sm font-light leading-relaxed text-gray-400 mb-6">
            Hyderabad, India<br/>
            connect@inspectivlabs.com
          </p>
          <div class="flex gap-4">
            <a href="#" class="w-10 h-10 rounded-full border border-gray-800 flex items-center justify-center text-gray-400 hover:border-[#1d4ed8] hover:text-[#1d4ed8] hover:bg-[#1d4ed8]/10 transition-all">
              <i class="bx bxl-linkedin text-lg"></i>
            </a>
            <a href="#" class="w-10 h-10 rounded-full border border-gray-800 flex items-center justify-center text-gray-400 hover:border-[#1d4ed8] hover:text-[#1d4ed8] hover:bg-[#1d4ed8]/10 transition-all">
              <i class="bx bxl-twitter text-lg"></i>
            </a>
          </div>
        </div>

      </div>
    </div>

    <div class="border-t border-gray-900 pt-8 flex flex-col md:flex-row items-center justify-between gap-6 text-[10px] font-medium tracking-widest text-gray-600 uppercase">
      <div class="flex items-center gap-3">
         <div class="flex gap-1.5 opacity-50">
           <div class="w-2 h-2 rounded-full bg-[#1d4ed8]"></div>
           <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
         </div>
         <span>&copy; {new Date().getFullYear()} Inspectiv Labs. All rights reserved.</span>
      </div>
      <div class="flex items-center gap-8">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="#" class="hover:text-white transition-colors">ISMS Policy</a>
      </div>
    </div>

  </div>

  <div class="absolute bottom-[-15%] left-1/2 -translate-x-1/2 text-[15vw] font-bold text-white/[0.02] whitespace-nowrap select-none pointer-events-none tracking-tighter leading-none flex items-center justify-center">
    INSPECTIV
  </div>
</footer>
