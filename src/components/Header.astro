---
import Container from './Container.astro';
import MobileNav from './react/MobileNav.tsx';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Industries', href: '/#industries' },
  { label: 'Solutions', href: '#' },
  { label: 'Insights', href: '/blog' },
];
---

<header id="main-header" class="fixed w-full top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-100 transition-all duration-300">
  <Container>
    <div class="flex items-center justify-between h-20 transition-all duration-300" id="header-container">
      {/* Logo */}
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-10 h-10 bg-primary rounded-lg flex items-center justify-center group-hover:bg-primary-700 transition-colors">
          <span class="text-white font-bold text-xl">IL</span>
        </div>
        <span class="font-heading font-bold text-xl text-slate-900 tracking-tight">Inspective<span class="text-primary">Labs</span></span>
      </a>

      {/* Desktop Navigation */}
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map(link => (
          <a href={link.href} class="text-sm font-medium text-slate-600 hover:text-primary transition-colors">
            {link.label}
          </a>
        ))}
      </nav>

      {/* CTA / Mobile Toggle */}
      <div class="flex items-center gap-4">
        <a href="/contact" class="hidden md:inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-700 transition-colors focus:ring-2 focus:ring-primary focus:outline-none">
          Contact Us
        </a>
        <MobileNav client:load links={navLinks} />
      </div>
    </div>
  </Container>
</header>

<script>
  // Shrink header on scroll
  const header = document.getElementById('main-header');
  const container = document.getElementById('header-container');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header?.classList.add('shadow-sm');
      container?.classList.replace('h-20', 'h-16');
    } else {
      header?.classList.remove('shadow-sm');
      container?.classList.replace('h-16', 'h-20');
    }
  });
</script>
