---
import MobileNav from './react/MobileNav.tsx';
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';
import headerImage from '../assets/header.png';

const navLinks = [
  { label: 'HOME', href: '/' },
  { 
    label: 'INDUSTRY', 
    href: '/#industries',
    children: [
      { label: 'Infrastructure & Construction', href: '/industries/infrastructure' },
      { label: 'Mining & Resources', href: '/industries/mining' },
      { label: 'Energy & Utilities', href: '/industries/energy' },
      { label: 'Urban Development', href: '/industries/urban-development' }
    ]
  },
  { 
    label: 'SOLUTIONS', 
    href: '/#solutions',
    children: [
      { label: 'Mine Operators', href: '/solutions/mine-operators' },
      { label: 'Geotech Consultants', href: '#' },
      { label: 'Banks & Financial Lenders', href: '#' },
      { label: 'Insurance Adjusters', href: '#' },
      { label: 'Infrastructure Owner and Developers', href: '#' }
    ]
  },
  { label: 'CASE STUDIES', href: '/#case-studies' },
  { 
    label: 'COMPANY', 
    href: '#',
    children: [
      { label: 'About Us', href: '/about' },
      { label: 'Technology', href: '/technology' }
    ]
  },
  { label: 'BLOGS/INSIGHTS', href: '/blog' }
];
---

{/* 1. Transparent Header (Shows on Carousel) */}
<header class="absolute top-0 left-0 right-0 bg-transparent w-full z-40">
  <div class="max-w-[1600px] mx-auto px-6 h-32 flex items-center justify-between">
    
    {/* Transparent Header Logo */}
    <a href="/" class="flex items-center gap-4">
      <Image src={headerImage} alt="InSpectiv Labs" class="h-20 md:h-24 w-auto object-contain drop-shadow-md" />
    </a>

    {/* Desktop Navigation */}
    <nav class="hidden lg:flex items-center gap-6 relative">
      {navLinks.map(link => (
        link.children ? (
          <div class="relative group">
            <a href={link.href} class="group/link text-white text-[14px] hover:text-cyan-400 transition-colors uppercase tracking-wide drop-shadow-sm font-semibold flex items-center gap-1 relative py-1">
              {link.label}
              <i class="bx bx-chevron-down text-lg mt-0.5 transition-transform duration-300 group-hover:rotate-180"></i>
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-cyan-400 transform scale-x-0 group-hover/link:scale-x-100 transition-transform duration-300 origin-left"></span>
            </a>
            <div class="absolute top-full left-0 pt-4 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-4 group-hover:translate-y-0 z-50">
              <div class="bg-white shadow-xl rounded-sm py-2 flex flex-col border border-gray-100">
                {link.children.map(child => (
                  <a href={child.href} class="px-6 py-3 text-sm text-gray-700 hover:bg-slate-50 hover:text-[#1d4ed8] transition-colors border-l-2 border-transparent hover:border-[#1d4ed8] font-semibold">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={link.href} class="group/link text-white text-[14px] hover:text-cyan-400 transition-colors uppercase tracking-wide drop-shadow-sm font-semibold relative py-1">
            {link.label}
            <span class="absolute bottom-0 left-0 w-full h-[2px] bg-cyan-400 transform scale-x-0 group-hover/link:scale-x-100 transition-transform duration-300 origin-left"></span>
          </a>
        )
      ))}
    </nav>

    {/* Mobile Toggle */}
    <div class="lg:hidden text-white">
       <MobileNav client:load links={navLinks} />
    </div>

  </div>
</header>

{/* 2. Solid Fixed Header (Slides down on scroll) */}
<header id="main-header" class="fixed top-0 left-0 right-0 bg-[#000f2c] w-full z-50 transform -translate-y-full transition-transform duration-300 shadow-md">
  <div class="max-w-[1600px] mx-auto px-6 h-24 flex items-center justify-between">
    
    {/* Solid Header Logo */}
    <a href="/" class="flex items-center gap-4">
      <Image src={logoImage} alt="InSpectiv Labs" class="h-16 md:h-20 w-auto object-contain" />
    </a>

    {/* Desktop Navigation */}
    <nav class="hidden lg:flex items-center gap-6 relative">
      {navLinks.map(link => (
        link.children ? (
          <div class="relative group">
            <a href={link.href} class="group/link text-white text-[13px] hover:text-cyan-400 transition-colors uppercase tracking-wide flex items-center gap-1 relative py-1">
              {link.label}
              <i class="bx bx-chevron-down text-lg mt-0.5 transition-transform duration-300 group-hover:rotate-180"></i>
              <span class="absolute bottom-0 left-0 w-full h-[2px] bg-cyan-400 transform scale-x-0 group-hover/link:scale-x-100 transition-transform duration-300 origin-left"></span>
            </a>
            <div class="absolute top-full left-0 pt-4 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-4 group-hover:translate-y-0 z-50">
              <div class="bg-white shadow-xl rounded-sm py-2 flex flex-col border border-gray-100">
                {link.children.map(child => (
                  <a href={child.href} class="px-6 py-3 text-sm text-gray-700 hover:bg-slate-50 hover:text-[#1d4ed8] transition-colors border-l-2 border-transparent hover:border-[#1d4ed8] font-semibold">
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={link.href} class="group/link text-white text-[13px] hover:text-cyan-400 transition-colors uppercase tracking-wide relative py-1">
            {link.label}
            <span class="absolute bottom-0 left-0 w-full h-[2px] bg-cyan-400 transform scale-x-0 group-hover/link:scale-x-100 transition-transform duration-300 origin-left"></span>
          </a>
        )
      ))}
      <a href="/contact" class="ml-2 px-5 py-2 bg-[#1d4ed8] text-white text-[13px] font-semibold uppercase tracking-wider transition-colors group/btn relative overflow-hidden">
        <span class="relative z-10">CONTACT US</span>
        <div class="absolute inset-0 w-full h-full bg-[#0f2952] transform -translate-x-full group-hover/btn:translate-x-0 transition-transform duration-300 ease-out z-0"></div>
      </a>
    </nav>

    {/* Mobile Toggle */}
    <div class="lg:hidden text-white">
       <MobileNav client:load links={navLinks} />
    </div>

  </div>
</header>

<script>
  // Show header only after scrolling past the first window height (hero section)
  window.addEventListener('scroll', () => {
    const header = document.getElementById('main-header');
    if (window.scrollY > window.innerHeight - 100) {
      header?.classList.remove('-translate-y-full');
      header?.classList.add('translate-y-0');
    } else {
      header?.classList.add('-translate-y-full');
      header?.classList.remove('translate-y-0');
    }
  });
</script>
