---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Fetch all non-draft posts and sort by publish date descending
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// NOTE FOR FUTURE SCALABILITY: 
// If non-technical staff require a headless CMS (like Sanity or Contentful), 
// this is the exact file where you would swap `getCollection('blog')` 
// with your CMS data-fetching logic (e.g. a GROQ query to Sanity).
---

<BaseLayout 
  title="Insights & News | InSpectiv Labs" 
  description="The latest industry trends, compliance updates, and risk intelligence insights from InSpectiv Labs."
>
  
  <section class="pt-40 pb-20 bg-[#000f2c] text-white text-center">
    <div class="max-w-[1000px] mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-light mb-6 tracking-wide">Insights & Analysis</h1>
      <p class="text-xl text-gray-300 font-light max-w-2xl mx-auto leading-relaxed">
        Strategic intelligence and technical trends across mining, geotech, insurance, and banking.
      </p>
    </div>
  </section>

  <section class="py-24 bg-gray-50 min-h-screen">
    <div class="max-w-[95vw] mx-auto px-4">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {posts.map((post) => (
          <article class="bg-white border border-gray-200 shadow-sm hover:shadow-lg transition-shadow flex flex-col group">
            <a href={`/blog/${post.id}`} class="block aspect-video overflow-hidden bg-gray-100 relative">
              {post.data.heroImage ? (
                <Image 
                  src={post.data.heroImage} 
                  alt={post.data.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-[#000f2c]">
                  <span class="text-gray-600 font-light">InSpectiv Labs</span>
                </div>
              )}
              {post.data.industry && (
                <div class="absolute top-4 left-4 px-3 py-1 bg-[#1d4ed8] text-white text-[11px] font-bold uppercase tracking-wider">
                  {post.data.industry}
                </div>
              )}
            </a>
            
            <div class="p-8 flex flex-col flex-grow">
              <time class="text-xs text-gray-500 mb-3 font-semibold tracking-wide">
                {post.data.publishDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric'
                })}
              </time>
              <h2 class="text-xl font-semibold text-[#000f2c] mb-4 leading-snug group-hover:text-[#1d4ed8] transition-colors">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <p class="text-gray-600 text-sm font-light leading-relaxed mb-8 flex-grow">
                {post.data.description}
              </p>
              
              <a href={`/blog/${post.id}`} class="mt-auto text-[#1d4ed8] text-xs font-bold uppercase tracking-wider hover:text-[#000f2c] transition-colors flex items-center gap-1">
                Read Article <span class="text-lg leading-none">›</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      {posts.length > 9 && (
        <div class="mt-20 text-center">
          {/* PLACEHOLDER: Implement Pagination or Load More here when post count exceeds 9 */}
          <button class="px-8 py-3 border border-gray-300 text-gray-600 text-sm uppercase tracking-wider font-semibold hover:bg-gray-100 transition-colors">
            Load More Articles
          </button>
        </div>
      )}

    </div>
  </section>

</BaseLayout>
