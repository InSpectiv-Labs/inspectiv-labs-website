---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/react/HeroCarousel.tsx';
import NetworkMap from '../components/NetworkMap.tsx';
---

<BaseLayout title="InSpectiv Labs | Risk Intelligence Platform">
  
  
  <section class="relative h-screen w-full">
    <HeroCarousel client:load />
  </section>

  
  <section id="overview" class="py-24 bg-white border-b border-gray-200 overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      
      <div class="flex flex-col items-start text-left">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
          OVERVIEW
        </h2>
        <h3 class="text-2xl text-gray-800 font-light mb-4">Protecting assets globally</h3>
        <p class="text-gray-600 text-lg font-light leading-relaxed">
          InSpectiv Labs provides an advanced Risk Intelligence platform built for the world’s most demanding sectors. By combining automated monitoring, predictive analytics, and secure data pipelines, we deliver actionable intelligence that protects assets, optimizes operations, and ensures regulatory compliance across your entire portfolio.
        </p>
      </div>

      
      <div class="relative w-full max-w-lg mx-auto lg:ml-auto lg:mr-0 mt-12 lg:mt-0">
        
        
        <div class="absolute left-[31px] top-8 bottom-8 w-0.5 bg-gray-100"></div>
        
        <div class="flex flex-col gap-12 relative z-10">
          
          
          <div class="group flex items-start gap-8">
            <div class="relative z-10 w-16 h-16 shrink-0 rounded-xl bg-white border border-gray-200 shadow-sm flex items-center justify-center text-[#1d4ed8] group-hover:border-[#1d4ed8] group-hover:shadow-md group-hover:shadow-[#1d4ed8]/10 transition-all duration-300">
              <i class="bx bx-target-lock text-3xl transition-transform duration-300 group-hover:scale-110"></i>
            </div>
            <div class="pt-1">
              <h3 class="text-xl font-semibold text-[#000f2c] mb-2 tracking-tight transition-colors duration-300 group-hover:text-[#1d4ed8]">Precision First</h3>
              <p class="text-gray-500 font-light leading-relaxed">We deliver verified, ground-truth data with uncompromised accuracy, ensuring absolute certainty across your operations.</p>
            </div>
          </div>

          
          <div class="group flex items-start gap-8">
            <div class="relative z-10 w-16 h-16 shrink-0 rounded-xl bg-white border border-gray-200 shadow-sm flex items-center justify-center text-[#1d4ed8] group-hover:border-[#1d4ed8] group-hover:shadow-md group-hover:shadow-[#1d4ed8]/10 transition-all duration-300">
              <i class="bx bx-shield-quarter text-3xl transition-transform duration-300 group-hover:scale-110"></i>
            </div>
            <div class="pt-1">
              <h3 class="text-xl font-semibold text-[#000f2c] mb-2 tracking-tight transition-colors duration-300 group-hover:text-[#1d4ed8]">Risk Mitigation</h3>
              <p class="text-gray-500 font-light leading-relaxed">Proactive threat identification and automated alerting systems designed to protect financial and structural assets.</p>
            </div>
          </div>

          
          <div class="group flex items-start gap-8">
            <div class="relative z-10 w-16 h-16 shrink-0 rounded-xl bg-white border border-gray-200 shadow-sm flex items-center justify-center text-[#1d4ed8] group-hover:border-[#1d4ed8] group-hover:shadow-md group-hover:shadow-[#1d4ed8]/10 transition-all duration-300">
              <i class="bx bx-badge-check text-3xl transition-transform duration-300 group-hover:scale-110"></i>
            </div>
            <div class="pt-1">
              <h3 class="text-xl font-semibold text-[#000f2c] mb-2 tracking-tight transition-colors duration-300 group-hover:text-[#1d4ed8]">Trusted Partner</h3>
              <p class="text-gray-500 font-light leading-relaxed">Built on transparency and reliability, we act as a foundational pillar for your organization's intelligence.</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  
  <section id="industries" class="py-24 bg-slate-50 border-y border-gray-200">
    <div class="max-w-[1600px] mx-auto px-6 text-center">
      <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">INDUSTRY</h2>
      <h3 class="text-2xl text-gray-800 font-light mb-16">Tailored for high-risk environments</h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        
        
        <div class="flex flex-col group bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow text-left overflow-hidden">
          <div class="w-full h-48 overflow-hidden relative">
            <img src="/images/industry_mining.png" alt="Mining Operations" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#000f2c]/90 via-[#000f2c]/40 to-transparent"></div>
            <div class="absolute bottom-4 left-6 flex items-center gap-3">
              <i class="bx bx-hard-hat text-2xl text-cyan-400"></i>
              <h3 class="text-[15px] font-semibold text-white uppercase tracking-wider">MINING OPERATIONS</h3>
            </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <p class="text-gray-600 text-sm font-semibold leading-relaxed mb-6 border-b border-gray-100 pb-4 h-[60px]">
              Zero-Infra safety intelligence for safer, more productive mines.
            </p>
            <ul class="space-y-3 mb-8 text-sm font-light text-gray-600 flex-grow">
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Detect slope instability & highwall movement</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Monitor tailings dams, dumps & embankments</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Improve safety & reduce unplanned downtime</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Support DGMS compliance & reporting</li>
            </ul>
            <a href="/industries/mining" class="mt-auto px-8 py-3 border border-[#2563eb] text-[#2563eb] text-xs uppercase tracking-wider font-semibold hover:bg-[#2563eb] hover:text-white transition-colors w-full text-center">
              LEARN MORE <span class="ml-1">›</span>
            </a>
          </div>
        </div>

        
        <div class="flex flex-col group bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow text-left overflow-hidden">
          <div class="w-full h-48 overflow-hidden relative">
            <img src="/images/industry_infrastructure.png" alt="Infrastructure & Construction" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#000f2c]/90 via-[#000f2c]/40 to-transparent"></div>
            <div class="absolute bottom-4 left-6 flex items-center gap-3">
              <i class="bx bx-building-house text-2xl text-cyan-400"></i>
              <h3 class="text-[15px] font-semibold text-white uppercase tracking-wider">INFRASTRUCTURE</h3>
            </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <p class="text-gray-600 text-sm font-semibold leading-relaxed mb-6 border-b border-gray-100 pb-4 h-[60px]">
              Protect critical infrastructure across its lifecycle.
            </p>
            <ul class="space-y-3 mb-8 text-sm font-light text-gray-600 flex-grow">
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Monitor bridges, highways, rail corridors</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Track settlement & subsidence near structures</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> De-risk tunneling, metro & deep excavations</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Ensure long-term structural health</li>
            </ul>
            <a href="/industries/infrastructure" class="mt-auto px-8 py-3 border border-[#2563eb] text-[#2563eb] text-xs uppercase tracking-wider font-semibold hover:bg-[#2563eb] hover:text-white transition-colors w-full text-center">
              LEARN MORE <span class="ml-1">›</span>
            </a>
          </div>
        </div>

        
        <div class="flex flex-col group bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow text-left overflow-hidden">
          <div class="w-full h-48 overflow-hidden relative">
            <img src="/images/industry_energy.png" alt="Oil, Gas & Energy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#000f2c]/90 via-[#000f2c]/40 to-transparent"></div>
            <div class="absolute bottom-4 left-6 flex items-center gap-3">
              <i class="bx bxs-bolt text-2xl text-cyan-400"></i>
              <h3 class="text-[15px] font-semibold text-white uppercase tracking-wider">OIL, GAS & ENERGY</h3>
            </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <p class="text-gray-600 text-sm font-semibold leading-relaxed mb-6 border-b border-gray-100 pb-4 h-[60px]">
              Monitor ground movement around energy assets.
            </p>
            <ul class="space-y-3 mb-8 text-sm font-light text-gray-600 flex-grow">
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Monitor well pads, pipelines & compressor stations</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Detect subsidence & ground instability early</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Reduce environmental & operational risks</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Improve asset integrity & lifecycle planning</li>
            </ul>
            <a href="/industries/energy" class="mt-auto px-8 py-3 border border-[#2563eb] text-[#2563eb] text-xs uppercase tracking-wider font-semibold hover:bg-[#2563eb] hover:text-white transition-colors w-full text-center">
              LEARN MORE <span class="ml-1">›</span>
            </a>
          </div>
        </div>

        
        <div class="flex flex-col group bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow text-left overflow-hidden">
          <div class="w-full h-48 overflow-hidden relative">
            <img src="/images/industry_urban.png" alt="Urban Development & Smart Cities" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#000f2c]/90 via-[#000f2c]/40 to-transparent"></div>
            <div class="absolute bottom-4 left-6 flex items-center gap-3">
              <i class="bx bx-buildings text-2xl text-cyan-400"></i>
              <h3 class="text-[15px] font-semibold text-white uppercase tracking-wider">URBAN DEVELOPMENT</h3>
            </div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <p class="text-gray-600 text-sm font-semibold leading-relaxed mb-6 border-b border-gray-100 pb-4 h-[60px]">
              Build resilient cities with continuous ground intelligence.
            </p>
            <ul class="space-y-3 mb-8 text-sm font-light text-gray-600 flex-grow">
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Monitor land subsidence in urban areas</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Support zoning, planning & compliance</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Detect risks near metros, utilities & buildings</li>
              <li class="flex items-start gap-2"><span class="text-[#1d4ed8] mt-0.5">✓</span> Enable proactive infrastructure management</li>
            </ul>
            <a href="/industries/urban-development" class="mt-auto px-8 py-3 border border-[#2563eb] text-[#2563eb] text-xs uppercase tracking-wider font-semibold hover:bg-[#2563eb] hover:text-white transition-colors w-full text-center">
              LEARN MORE <span class="ml-1">›</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  
  <section id="solutions" class="py-24 bg-white border-b border-gray-200">
    <div class="max-w-[1600px] mx-auto px-6">
      
      <div class="text-center mb-16">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">OUR SOLUTIONS</h2>
        <h3 class="text-2xl text-gray-800 font-light mb-4">Tailored Intelligence for Your Needs.</h3>
        <p class="text-gray-600 text-lg font-light max-w-2xl mx-auto">
          Empowering different stakeholders with precise, actionable insights. From mine operations to financial lending, we provide the ground-truth intelligence you need.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-6">
        
        
        <div class="flex-grow-0 flex-shrink-0 basis-full md:basis-[calc(50%-12px)] lg:basis-[calc(33.333%-16px)] flex flex-col bg-white border border-gray-100 p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 group">
          <div class="flex flex-col gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#1d4ed8]/5 flex items-center justify-center text-[#1d4ed8] group-hover:bg-[#1d4ed8] group-hover:text-white transition-all duration-300">
              <i class="bx bx-hard-hat text-2xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-[#000f2c] uppercase">Mine Operators</h3>
          </div>
          <p class="text-gray-500 text-sm font-light mb-8 flex-grow leading-relaxed">
            Enhance safety and productivity with continuous monitoring of highwalls, slopes, and tailings dams. Proactively manage risks before they impact operations.
          </p>
          <a href="/solutions/mine-operators" class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-[#1d4ed8] hover:text-[#0b5ed7] uppercase tracking-wider group-hover:translate-x-2 transition-transform">
            Learn More <i class="bx bx-right-arrow-alt text-lg"></i>
          </a>
        </div>

        
        <div class="flex-grow-0 flex-shrink-0 basis-full md:basis-[calc(50%-12px)] lg:basis-[calc(33.333%-16px)] flex flex-col bg-white border border-gray-100 p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 group">
          <div class="flex flex-col gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#1d4ed8]/5 flex items-center justify-center text-[#1d4ed8] group-hover:bg-[#1d4ed8] group-hover:text-white transition-all duration-300">
              <i class="bx bx-map-alt text-2xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-[#000f2c] uppercase">Geotech Consultants</h3>
          </div>
          <p class="text-gray-500 text-sm font-light mb-8 flex-grow leading-relaxed">
            Leverage ground-truth satellite data to supplement site investigations. Provide clients with comprehensive stability verification.
          </p>
          <a href="#" class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-[#1d4ed8] hover:text-[#0b5ed7] uppercase tracking-wider group-hover:translate-x-2 transition-transform">
            Learn More <i class="bx bx-right-arrow-alt text-lg"></i>
          </a>
        </div>

        
        <div class="flex-grow-0 flex-shrink-0 basis-full md:basis-[calc(50%-12px)] lg:basis-[calc(33.333%-16px)] flex flex-col bg-white border border-gray-100 p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 group">
          <div class="flex flex-col gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#1d4ed8]/5 flex items-center justify-center text-[#1d4ed8] group-hover:bg-[#1d4ed8] group-hover:text-white transition-all duration-300">
              <i class="bx bx-building-house text-2xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-[#000f2c] uppercase leading-tight">Infrastructure Owners</h3>
          </div>
          <p class="text-gray-500 text-sm font-light mb-8 flex-grow leading-relaxed">
            Monitor settlement, track structural health, and protect long-term asset integrity for bridges, highways, and critical urban developments.
          </p>
          <a href="#" class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-[#1d4ed8] hover:text-[#0b5ed7] uppercase tracking-wider group-hover:translate-x-2 transition-transform">
            Learn More <i class="bx bx-right-arrow-alt text-lg"></i>
          </a>
        </div>

        
        <div class="flex-grow-0 flex-shrink-0 basis-full md:basis-[calc(50%-12px)] lg:basis-[calc(33.333%-16px)] flex flex-col bg-white border border-gray-100 p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 group">
          <div class="flex flex-col gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#1d4ed8]/5 flex items-center justify-center text-[#1d4ed8] group-hover:bg-[#1d4ed8] group-hover:text-white transition-all duration-300">
              <i class="bx bx-line-chart text-2xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-[#000f2c] uppercase leading-tight">Banks & Lenders</h3>
          </div>
          <p class="text-gray-500 text-sm font-light mb-8 flex-grow leading-relaxed">
            Verify stability and assess environmental risks before and during capital investments. Ensure projects meet regulatory compliance.
          </p>
          <a href="#" class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-[#1d4ed8] hover:text-[#0b5ed7] uppercase tracking-wider group-hover:translate-x-2 transition-transform">
            Learn More <i class="bx bx-right-arrow-alt text-lg"></i>
          </a>
        </div>

        
        <div class="flex-grow-0 flex-shrink-0 basis-full md:basis-[calc(50%-12px)] lg:basis-[calc(33.333%-16px)] flex flex-col bg-white border border-gray-100 p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 group">
          <div class="flex flex-col gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#1d4ed8]/5 flex items-center justify-center text-[#1d4ed8] group-hover:bg-[#1d4ed8] group-hover:text-white transition-all duration-300">
              <i class="bx bx-shield text-2xl"></i>
            </div>
            <h3 class="text-lg font-semibold text-[#000f2c] uppercase">Insurance Adjusters</h3>
          </div>
          <p class="text-gray-500 text-sm font-light mb-8 flex-grow leading-relaxed">
            Validate subsidence claims with historical, millimeter-level displacement data. Accurately assess ground movement history.
          </p>
          <a href="#" class="mt-auto inline-flex items-center gap-2 text-sm font-semibold text-[#1d4ed8] hover:text-[#0b5ed7] uppercase tracking-wider group-hover:translate-x-2 transition-transform">
            Learn More <i class="bx bx-right-arrow-alt text-lg"></i>
          </a>
        </div>

      </div>
      

      
    </div>
  </section>

  
  <section class="py-24 bg-slate-50">
    <div class="max-w-[1600px] mx-auto px-6 text-center">
      <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">LATEST INSIGHTS</h2>
      <h3 class="text-2xl text-gray-800 font-light mb-4">Discover our recent studies.</h3>
      <p class="text-gray-600 text-lg font-light max-w-2xl mx-auto mb-16">
        Stay updated with our latest analyses, case studies, and industry intelligence reports.
      </p>
      
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 w-full max-w-6xl mx-auto mb-16 text-left">
        
        
        <div class="lg:col-span-7 bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 group cursor-pointer flex flex-col">
          <div class="h-[250px] sm:h-[350px] relative overflow-hidden shrink-0">
            <img src="https://images.unsplash.com/photo-1578328819058-b69f3a3b0f6b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" alt="Mining operation" class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700 ease-out" />
          </div>
          <div class="p-8 sm:p-10 flex flex-col flex-grow">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-sm font-semibold text-[#1d4ed8] uppercase tracking-wider">Mining</span>
              <span class="w-1 h-1 rounded-full bg-gray-300"></span>
              <p class="text-gray-500 text-sm font-light">May 14, 2026</p>
            </div>
            <h3 class="text-2xl sm:text-3xl font-bold text-[#000f2c] mb-4 group-hover:text-[#1d4ed8] transition-colors leading-tight">Preventing Tailing Dam Failures with Daily InSAR Monitoring</h3>
            <p class="text-gray-600 text-base font-light leading-relaxed mb-8 flex-grow">
              How a major copper mine in Chile utilized our daily displacement data to identify a 3mm movement anomaly weeks before visible cracking occurred, saving millions in potential downtime.
            </p>
            <a href="/blog/mining-lenders" class="inline-flex items-center gap-2 text-sm font-semibold text-[#1d4ed8] uppercase tracking-wider group-hover:translate-x-2 transition-transform mt-auto w-max">
              Read Full Report <i class="bx bx-right-arrow-alt text-xl"></i>
            </a>
          </div>
        </div>

        
        <div class="lg:col-span-5 flex flex-col gap-8">
          
          
          <div class="bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 group cursor-pointer flex flex-col sm:flex-row h-full">
            <div class="h-48 sm:h-auto sm:w-2/5 relative overflow-hidden shrink-0">
              <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Urban infrastructure" class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700 ease-out" />
            </div>
            <div class="p-6 sm:w-3/5 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs font-semibold text-[#1d4ed8] uppercase tracking-wider">Analysis</span>
                <span class="w-1 h-1 rounded-full bg-gray-300"></span>
                <p class="text-gray-500 text-xs font-light">April 28, 2026</p>
              </div>
              <h3 class="text-lg font-bold text-[#000f2c] mb-3 group-hover:text-[#1d4ed8] transition-colors leading-snug">5 Compliance Trends in Geotech Monitoring</h3>
              <a href="/blog/geotech-compliance" class="inline-flex items-center gap-1 text-xs font-semibold text-gray-500 hover:text-[#1d4ed8] uppercase tracking-wider group-hover:translate-x-1 transition-all mt-auto w-max">
                Read Article <i class="bx bx-right-arrow-alt text-base"></i>
              </a>
            </div>
          </div>

          
          <div class="bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 group cursor-pointer flex flex-col sm:flex-row h-full">
            <div class="h-48 sm:h-auto sm:w-2/5 relative overflow-hidden shrink-0">
              <img src="https://images.unsplash.com/photo-1621682337775-40899f57f495?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Technology visualization" class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700 ease-out" />
            </div>
            <div class="p-6 sm:w-3/5 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs font-semibold text-[#1d4ed8] uppercase tracking-wider">Insurance</span>
                <span class="w-1 h-1 rounded-full bg-gray-300"></span>
