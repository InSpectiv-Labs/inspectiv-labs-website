---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import HeroBackground from '../components/react/HeroBackground.tsx';
import TestimonialCarousel from '../components/react/TestimonialCarousel.tsx';

export const prerender = true;
---
<BaseLayout 
  title="Inspective Labs - Precision Inspection & Risk Intelligence" 
  description="Premium B2B services delivering actionable risk intelligence for insurance, finance, geotech, and mining sectors."
>
  
  {/* 1. Hero/Banner */}
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
    <HeroBackground client:load />
    <Container className="relative z-10 text-center text-white py-20 mt-10">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 mb-8">
        <span class="w-2 h-2 rounded-full bg-secondary-400 animate-pulse"></span>
        <span class="text-sm font-medium tracking-wide">Enterprise Intelligence Platform</span>
      </div>
      
      {/* PLACEHOLDER: Client to finalize tagline */}
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-heading font-bold mb-6 tracking-tight max-w-4xl mx-auto leading-tight">
        Precision Inspection & Risk Intelligence for <span class="text-secondary-400">[Industry]</span>
      </h1>
      
      <p class="text-xl md:text-2xl text-slate-300 max-w-2xl mx-auto mb-10 font-light">
        We transform complex field data into actionable strategic insights, securing your infrastructure and financial assets.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <Button variant="secondary" size="lg" href="#industries">Explore Solutions</Button>
        <Button variant="outline" size="lg" href="/contact" className="border-white text-white hover:bg-white hover:text-slate-900 focus:ring-white">Book a Consultation</Button>
      </div>
    </Container>
  </section>

  {/* 2. Company Overview */}
  <section class="py-24 bg-white">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-heading font-bold text-slate-900 mb-6">Securing the Future of Global Industries</h2>
        <p class="text-xl text-slate-600 leading-relaxed">
          Inspective Labs is a premier B2B intelligence firm specializing in advanced risk assessment and infrastructure analysis. By combining proprietary field methodologies with cutting-edge data science, we empower the world's leading organizations to mitigate risk, ensure compliance, and optimize their most critical operations.
        </p>
      </div>
    </Container>
  </section>

  {/* 3. Vision / Mission / Core Values */}
  <section class="py-24 bg-slate-50 border-y border-slate-100">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center md:text-left">
        {/* Vision */}
        <div class="p-6">
          <div class="w-14 h-14 bg-primary-100 text-primary-600 rounded-xl flex items-center justify-center mx-auto md:mx-0 mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Our Vision</h3>
          <p class="text-slate-600">To be the global standard for operational intelligence, making complex industrial environments universally transparent and secure.</p>
        </div>
        
        {/* Mission */}
        <div class="p-6">
          <div class="w-14 h-14 bg-primary-100 text-primary-600 rounded-xl flex items-center justify-center mx-auto md:mx-0 mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Our Mission</h3>
          <p class="text-slate-600">Delivering uncompromising precision in risk assessment through technological innovation and deep industry expertise.</p>
        </div>

        {/* Values */}
        <div class="p-6">
          <div class="w-14 h-14 bg-primary-100 text-primary-600 rounded-xl flex items-center justify-center mx-auto md:mx-0 mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900 mb-3">Core Values</h3>
          <p class="text-slate-600">We operate on the pillars of absolute integrity, analytical rigor, and a relentless commitment to our clients' security.</p>
        </div>
      </div>
    </Container>
  </section>

  {/* 4. Industry Selection */}
  <section id="industries" class="py-24 bg-white">
    <Container>
      <SectionHeading 
        eyebrow="Specialized Expertise"
        title="Industries We Serve" 
        description="Tailored intelligence and risk assessment protocols designed for the unique challenges of your sector."
        alignment="center"
        className="mb-16"
      />
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <Card 
          title="Insurance Companies" 
          description="Comprehensive claims validation, structural assessments, and predictive risk modeling." 
          href="/industries/insurance" 
          className="border-primary-100 hover:border-primary-300"
        >
          <div class="mt-4 text-primary-600 group-hover:text-primary-700 font-medium text-sm flex items-center gap-1 transition-colors">
            View Solutions <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </Card>
        
        <Card 
          title="Financial Lenders" 
          description="Due diligence, asset condition monitoring, and compliance verification for major investments." 
          href="/industries/banking"
          className="border-primary-100 hover:border-primary-300"
        >
          <div class="mt-4 text-primary-600 group-hover:text-primary-700 font-medium text-sm flex items-center gap-1 transition-colors">
            View Solutions <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </Card>

        <Card 
          title="Geotech Consultants" 
          description="Advanced geospatial analysis, subsidence monitoring, and site integrity evaluations." 
          href="/industries/geotech"
          className="border-primary-100 hover:border-primary-300"
        >
          <div class="mt-4 text-primary-600 group-hover:text-primary-700 font-medium text-sm flex items-center gap-1 transition-colors">
            View Solutions <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </Card>

        <Card 
          title="Mining Companies" 
          description="Environmental compliance, volumetric analysis, and operational safety inspections." 
          href="/industries/mining"
          className="border-primary-100 hover:border-primary-300"
        >
          <div class="mt-4 text-primary-600 group-hover:text-primary-700 font-medium text-sm flex items-center gap-1 transition-colors">
            View Solutions <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </Card>
      </div>
    </Container>
  </section>

  {/* 5. Key Services */}
  <section class="py-24 bg-slate-900 text-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <SectionHeading 
            eyebrow="Core Capabilities"
            title="Intelligence at Scale" 
            description="Our service framework is built to handle the most demanding corporate environments, ensuring accuracy, speed, and absolute confidentiality."
          />
          <div class="mt-8">
            <Button variant="secondary" href="/contact">Discuss Your Needs</Button>
          </div>
        </div>
        
        <div class="space-y-8">
          <div class="flex gap-4">
            <div class="mt-1 bg-slate-800 p-3 rounded-lg text-secondary-400 shrink-0">
               <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
            </div>
            <div>
              <h3 class="text-xl font-heading font-bold mb-2">Predictive Analytics</h3>
              <p class="text-slate-400">Leverage historical data and machine learning to forecast potential structural or financial risks before they materialize.</p>
            </div>
          </div>
          
          <div class="flex gap-4">
            <div class="mt-1 bg-slate-800 p-3 rounded-lg text-secondary-400 shrink-0">
               <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <div>
              <h3 class="text-xl font-heading font-bold mb-2">High-Resolution Inspections</h3>
              <p class="text-slate-400">Deploying state-of-the-art sensory equipment to capture millimeter-accurate data across vast or inaccessible portfolios.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="mt-1 bg-slate-800 p-3 rounded-lg text-secondary-400 shrink-0">
               <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
            </div>
            <div>
              <h3 class="text-xl font-heading font-bold mb-2">Compliance Verification</h3>
              <p class="text-slate-400">Automated auditing protocols ensuring your assets strictly adhere to local and international regulatory frameworks.</p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  {/* 6. Testimonials */}
  <section class="py-24 bg-slate-50">
    <Container>
      <SectionHeading 
        eyebrow="Client Success"
        title="Trusted by Leaders" 
        alignment="center"
        className="mb-16"
      />
      
      <TestimonialCarousel client:visible />
    </Container>
  </section>

  {/* 7. Final CTA */}
  <section class="py-24 bg-primary text-white relative overflow-hidden">
    {/* Background accent */}
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-primary-700 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/2 opacity-50 pointer-events-none"></div>
    
    <Container className="relative z-10 text-center">
      <h2 class="text-4xl md:text-5xl font-heading font-bold mb-6">Ready to secure your operations?</h2>
      <p class="text-xl text-primary-100 max-w-2xl mx-auto mb-10">
        Join the industry leaders who rely on Inspective Labs for definitive risk intelligence.
      </p>
      <div class="flex justify-center">
        <Button variant="secondary" size="lg" href="/contact" className="shadow-xl shadow-secondary-500/20">Contact Us Today</Button>
      </div>
    </Container>
  </section>
  
</BaseLayout>
