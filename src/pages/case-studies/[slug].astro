---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { caseStudies, type CaseStudy } from '../../data/caseStudies';

export function getStaticPaths() {
  return caseStudies
    .filter(study => study.pageTitle) // Only build pages that have full content
    .map(study => ({
      params: { slug: study.slug },
      props: { study },
    }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---
<BaseLayout title={`${study.pageTitle} - Case Study | InSpectiv Labs`} description={study.executiveSummary}>
  
  <!-- Hero Section -->
  <section class="relative pt-32 lg:pt-48 pb-16 lg:pb-24 bg-[#000f2c] text-white overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-cyan-500 rounded-[100%] blur-[120px] opacity-10 pointer-events-none"></div>
    
    <div class="relative z-10 max-w-[80vw] mx-auto px-6">

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-light mb-6 tracking-wide leading-tight">{study.pageTitle}</h1>
      <p class="text-lg md:text-xl text-gray-300 font-light max-w-3xl leading-relaxed">
        {study.pageSubtitle}
      </p>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-[80vw] mx-auto px-6">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-20">
        
        <!-- Left Column (Content) -->
        <div class="lg:w-2/3 space-y-12">
          
          <!-- Executive Summary -->
          {study.executiveSummary && (
            <div>
              <h2 class="text-3xl md:text-4xl font-semibold text-[#000f2c] mb-4 tracking-tight relative pb-6">
                Executive Summary
                <span class="absolute bottom-0 left-0 w-16 h-1 bg-cyan-500 rounded-full"></span>
              </h2>
              <p class="text-lg text-gray-600 font-light leading-relaxed text-justify">{study.executiveSummary}</p>
            </div>
          )}

          <!-- The Challenge -->
          {study.challenge && (
            <div>
              <h2 class="text-3xl md:text-4xl font-semibold text-[#000f2c] mb-4 tracking-tight relative pb-6">
                The Challenge
                <span class="absolute bottom-0 left-0 w-16 h-1 bg-cyan-500 rounded-full"></span>
              </h2>
              <p class="text-lg text-gray-600 font-light leading-relaxed text-justify">{study.challenge}</p>
            </div>
          )}

          <!-- Solution & Methodology -->
          {study.methodology && (
            <div>
              <h2 class="text-3xl md:text-4xl font-semibold text-[#000f2c] mb-4 tracking-tight relative pb-6">
                InSpectiv Labs Solution & Methodology
                <span class="absolute bottom-0 left-0 w-16 h-1 bg-cyan-500 rounded-full"></span>
              </h2>
              <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-sm space-y-6">
                <div class="flex flex-col md:flex-row gap-4 md:gap-8">
                  <div class="md:w-1/3">
                    <h3 class="text-sm font-bold text-cyan-700 uppercase tracking-wider">Data Engine</h3>
                  </div>
                  <div class="md:w-2/3 text-gray-700 font-light">{study.methodology.dataEngine}</div>
                </div>
                <div class="h-px bg-gray-100 w-full"></div>
                <div class="flex flex-col md:flex-row gap-4 md:gap-8">
                  <div class="md:w-1/3">
                    <h3 class="text-sm font-bold text-cyan-700 uppercase tracking-wider">Processing Technique</h3>
                  </div>
                  <div class="md:w-2/3 text-gray-700 font-light">{study.methodology.processingTechnique}</div>
                </div>
                <div class="h-px bg-gray-100 w-full"></div>
                <div class="flex flex-col md:flex-row gap-4 md:gap-8">
                  <div class="md:w-1/3">
                    <h3 class="text-sm font-bold text-cyan-700 uppercase tracking-wider">Measurement Physics</h3>
                  </div>
                  <div class="md:w-2/3 text-gray-700 font-light">{study.methodology.measurementPhysics}</div>
                </div>
                <div class="h-px bg-gray-100 w-full"></div>
                <div class="flex flex-col md:flex-row gap-4 md:gap-8">
                  <div class="md:w-1/3">
                    <h3 class="text-sm font-bold text-cyan-700 uppercase tracking-wider">Analytical Focus</h3>
                  </div>
                  <div class="md:w-2/3 text-gray-700 font-light">{study.methodology.analyticalFocus}</div>
                </div>
              </div>
            </div>
          )}

          <!-- Image Placeholder -->
          {study.imagePlaceholder && (
            <div class="my-12">
              <figure class="bg-white border border-gray-100 rounded-xl overflow-hidden shadow-sm p-4 md:p-6">
                <img src={study.imagePlaceholder.src} alt={study.pageTitle} class="w-full h-auto rounded-lg" />
                <figcaption class="mt-4 text-sm text-gray-500 font-light italic leading-relaxed text-center px-4">
                  {study.imagePlaceholder.caption}
                </figcaption>
              </figure>
            </div>
          )}

          <!-- Key Technical Findings -->
          {study.technicalFindings && study.technicalFindings.length > 0 && (
            <div>
              <h2 class="text-3xl md:text-4xl font-semibold text-[#000f2c] mb-4 tracking-tight relative pb-6">
                Key Technical Findings
                <span class="absolute bottom-0 left-0 w-16 h-1 bg-cyan-500 rounded-full"></span>
              </h2>
              <div class="overflow-x-auto">
                <table class="w-full bg-white border border-gray-100 shadow-sm rounded-xl overflow-hidden">
                  <thead class="bg-gray-50 border-b border-gray-100">
                    <tr>
                      <th class="text-left py-4 px-6 text-sm font-bold text-gray-900">Zone Classification</th>
                      <th class="text-left py-4 px-6 text-sm font-bold text-gray-900">Observed Satellite Signal</th>
                      <th class="text-left py-4 px-6 text-sm font-bold text-gray-900">Geotechnical Interpretation & Action</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    {study.technicalFindings.map((finding) => (
                      <tr class="hover:bg-gray-50/50 transition-colors">
                        <td class="py-5 px-6 align-top">
                          <span class="inline-block px-3 py-1 bg-red-100 text-red-800 text-xs font-bold rounded-sm whitespace-nowrap">
                            {finding.zoneClassification}
                          </span>
                        </td>
                        <td class="py-5 px-6 text-sm text-gray-600 font-light leading-relaxed align-top">
                          {finding.observedSignal}
                        </td>
                        <td class="py-5 px-6 text-sm text-gray-600 font-light leading-relaxed align-top">
                          {finding.interpretation}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

        </div>

        <!-- Right Column (Sidebar) -->
        <div class="lg:w-1/3">
          <div class="sticky top-32 space-y-8">
            
            <!-- Business Impact Card -->
            {study.businessImpact && study.businessImpact.length > 0 && (
              <div class="bg-[#000f2c] text-white p-8 rounded-xl shadow-lg relative overflow-hidden">
                <div class="absolute top-0 right-0 w-32 h-32 bg-[#1d4ed8] opacity-20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
                
                <h3 class="text-xl font-bold mb-6 flex items-center gap-3">
                  <i class="bx bx-trending-up text-[#1d4ed8] text-2xl"></i>
                  Business Impact
                </h3>
                
                <div class="space-y-6">
                  {study.businessImpact.map((impact) => (
                    <div class="flex gap-4">
                      <div class="mt-1 flex-shrink-0">
                        <div class="w-1.5 h-1.5 rounded-full bg-cyan-400"></div>
                      </div>
                      <div>
                        <h4 class="font-bold text-sm text-gray-100 mb-1">{impact.title}</h4>
                        <p class="text-sm text-gray-400 font-light leading-relaxed">{impact.description}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
            
            <!-- CTA Card -->
            <div class="bg-cyan-50 border border-cyan-100 p-8 rounded-xl shadow-sm text-center">
              <h3 class="text-xl font-bold text-gray-900 mb-4">Want similar insights for your assets?</h3>
              <p class="text-gray-600 font-light text-sm mb-6">Connect with our geotechnical monitoring experts to discuss your requirements.</p>
              <a href="/contact" class="inline-block px-6 py-3 bg-[#1d4ed8] text-white text-sm font-bold uppercase tracking-widest rounded-sm hover:bg-[#1e40af] transition-colors w-full shadow-md">
                Contact Us
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>
  
</BaseLayout>
