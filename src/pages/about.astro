---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us | InSpectiv Labs" description="Specialists in satellite-based ground monitoring solutions for mining, infrastructure, insurance, and energy sectors.">
  
  {/* 1. Enhanced Hero Section */}
  <section class="relative pt-32 pb-12 bg-[#000f2c] text-white overflow-hidden flex items-end min-h-[35vh]">
    <div class="absolute inset-0 z-0">
      <img src="/images/satellite_hero.jpg" alt="Satellite over Earth" class="w-full h-full object-cover grayscale mix-blend-screen opacity-20" />
      <div class="absolute inset-0 bg-gradient-to-b from-[#000f2c] via-[#000f2c]/80 to-[#000f2c]"></div>
    </div>
    
    <div class="relative z-10 max-w-[95vw] mx-auto px-4 w-full mt-12">
      <h1 class="text-4xl md:text-5xl lg:text-7xl font-light leading-tight tracking-tight text-white mb-4 uppercase">
        About Us
      </h1>
      <p class="text-xl md:text-2xl text-cyan-400 font-light max-w-3xl italic leading-relaxed border-l-2 border-cyan-400 pl-4 mb-8">
        "Precision Earth Monitoring with InSAR."
      </p>
    </div>
  </section>

  {/* 2. Core Capabilities */}
  <section class="py-16 md:py-24 bg-white border-b border-gray-200">
    <div class="max-w-[95vw] mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
        
        {/* Left: Statement */}
        <div class="lg:col-span-5 lg:sticky lg:top-32">
          <p class="text-3xl md:text-4xl text-[#000f2c] font-light leading-snug tracking-tight">
            <strong class="font-semibold">InSpectiv Labs</strong> specializes in satellite-based ground monitoring solutions for the mining, infrastructure, insurance, and energy sectors.
          </p>
        </div>

        {/* Right: Pillars */}
        <div class="lg:col-span-7 flex flex-col">
          
          <div class="border-t border-gray-200 py-8 first:border-t-0 lg:first:border-t lg:first:pt-8 lg:first:mt-0 first:pt-0">
            <div class="flex gap-6 items-start">
              <i class="bx bx-radar text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
              <div>
                <h3 class="text-lg font-semibold text-[#000f2c] uppercase tracking-wide mb-3">Advanced InSAR</h3>
                <p class="text-gray-600 font-light leading-relaxed text-base">
                  We use orbital radar technology to detect and track ground deformation with unprecedented millimeter precision.
                </p>
              </div>
            </div>
          </div>

          <div class="border-t border-gray-200 py-8">
            <div class="flex gap-6 items-start">
              <i class="bx bx-shield-quarter text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
              <div>
                <h3 class="text-lg font-semibold text-[#000f2c] uppercase tracking-wide mb-3">Risk Management</h3>
                <p class="text-gray-600 font-light leading-relaxed text-base">
                  Helping organizations proactively manage geotechnical risk and ensure operational safety at all times.
                </p>
              </div>
            </div>
          </div>

          <div class="border-y border-gray-200 py-8">
            <div class="flex gap-6 items-start">
              <i class="bx bx-buildings text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
              <div>
                <h3 class="text-lg font-semibold text-[#000f2c] uppercase tracking-wide mb-3">Asset Protection</h3>
                <p class="text-gray-600 font-light leading-relaxed text-base">
                  Protect high-value critical infrastructure and assets before structural failure or catastrophic collapse occurs.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>


</BaseLayout>
