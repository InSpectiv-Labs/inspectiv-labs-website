---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About Us | InSpectiv Labs" description="Specialists in satellite-based ground monitoring solutions for mining, infrastructure, insurance, and energy sectors.">
  
  {/* 1. Enhanced Hero Section */}
  <section class="relative pt-24 md:pt-32 lg:pt-40 pb-16 md:pb-24 lg:pb-32 bg-[#000f2c] text-white">
    <div class="absolute inset-0 opacity-30">
      <img src="/images/satellite_hero.png" alt="About Us" class="w-full h-full object-cover" />
    </div>
    
    <div class="relative z-10 max-w-[90vw] mx-auto px-6 text-center">
      <h1 class="text-3xl md:text-4xl md:text-5xl lg:text-6xl font-light mb-8 leading-tight tracking-wide">
        About Us
      </h1>
      <p class="text-lg md:text-xl text-gray-300 font-light leading-relaxed max-w-3xl mx-auto">
        Precision Earth Monitoring with InSAR.
      </p>
    </div>
  </section>

  {/* 2. Core Capabilities */}
  <section class="py-8 md:py-12 lg:py-16 md:py-24 bg-white border-b border-gray-200">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
        
        {/* Left: Statement */}
        <div class="lg:col-span-5 lg:sticky lg:top-32">
          <p class="text-2xl md:text-3xl lg:text-4xl md:text-4xl text-[#000f2c] font-light leading-snug tracking-tight">
            <strong class="font-semibold">InSpectiv Labs</strong> specializes in satellite-based ground monitoring solutions for the mining, infrastructure, insurance, and energy sectors.
          </p>
        </div>

        {/* Right: Pillars */}
        <div class="lg:col-span-7 flex flex-col">
          
          <div class="border-t border-gray-200 py-8 first:border-t-0 lg:first:border-t lg:first:pt-8 lg:first:mt-0 first:pt-0">
            <div class="flex gap-6 items-start">
              <i class="bx bx-radar text-xl md:text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
              <div>
                <h3 class="text-base md:text-lg font-semibold text-[#000f2c] uppercase tracking-wide mb-3">Advanced InSAR</h3>
                <p class="text-gray-600 font-light leading-relaxed text-base">
                  We use orbital radar technology to detect and track ground deformation with unprecedented millimeter precision.
                </p>
              </div>
            </div>
          </div>

          <div class="border-t border-gray-200 py-8">
            <div class="flex gap-6 items-start">
              <i class="bx bx-shield-quarter text-xl md:text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
              <div>
                <h3 class="text-base md:text-lg font-semibold text-[#000f2c] uppercase tracking-wide mb-3">Risk Management</h3>
                <p class="text-gray-600 font-light leading-relaxed text-base">
                  Helping organizations proactively manage geotechnical risk and ensure operational safety at all times.
                </p>
              </div>
            </div>
          </div>

          <div class="border-y border-gray-200 py-8">
            <div class="flex gap-6 items-start">
              <i class="bx bx-buildings text-xl md:text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
              <div>
                <h3 class="text-base md:text-lg font-semibold text-[#000f2c] uppercase tracking-wide mb-3">Asset Protection</h3>
                <p class="text-gray-600 font-light leading-relaxed text-base">
                  Protect high-value critical infrastructure and assets before structural failure or catastrophic collapse occurs.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>


</BaseLayout>
