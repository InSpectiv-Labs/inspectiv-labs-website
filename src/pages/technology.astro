---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechnologyTimeline from '../components/react/TechnologyTimeline';
---

<BaseLayout title="Our Technology | InSpectiv Labs" description="Advanced InSAR processing and AI/ML analytics for millimeter-level ground deformation intelligence.">
  
  {/* 1. Enhanced Hero Section */}
  <section class="relative pt-40 pb-32 bg-[#000f2c] text-white overflow-hidden flex items-center min-h-[60vh]">
    <div class="absolute inset-0 z-0">
      <img src="/images/insar_interferogram.jpg" alt="InSAR Processing Technology" class="w-full h-full object-cover mix-blend-screen opacity-50" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#000f2c] via-[#000f2c]/60 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#000f2c] via-[#000f2c]/40 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-[95vw] mx-auto px-4 w-full mt-8">
      <h1 class="text-5xl md:text-7xl font-light mb-8 tracking-widest uppercase bg-clip-text text-transparent bg-gradient-to-r from-white to-gray-400">Our Technology</h1>
      <p class="text-2xl md:text-3xl text-cyan-400 font-light max-w-3xl italic leading-relaxed border-l-4 border-cyan-400 pl-6 shadow-cyan-400/20 drop-shadow-lg">
        "Transforming satellite radar into millimeter-level precision."
      </p>
    </div>
  </section>

  {/* 2. Technology Timeline Section */}
  <section class="py-32 bg-white relative overflow-hidden">
    <div class="max-w-[95vw] mx-auto px-4 relative z-10">
      
      <div class="text-center mb-24">
        <h3 class="text-4xl md:text-5xl font-light mb-6 tracking-wide text-gray-900 uppercase">Technology You Can Trust</h3>
        <p class="text-lg text-gray-600 font-light max-w-2xl mx-auto">
          Transforming raw satellite radar data into clear, decisive 3D visualizations and high-precision interferograms.
        </p>
      </div>

      <TechnologyTimeline client:load />
    </div>
  </section>

</BaseLayout>
