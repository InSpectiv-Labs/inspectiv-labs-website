---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Financial Institutions & Lenders | InSpectiv Labs"
  description="Assess and monitor the physical risk of financed mining, infrastructure, energy and urban-development assets with satellite-based ground deformation intelligence."
>
  {/* 1. Hero / Introduction */}
  <section class="relative pt-40 pb-32 bg-[#000f2c] text-white">
    <div class="absolute inset-0 opacity-30">
      <img
        src="/images/infrastructure_monitoring.png"
        alt="Financial Risk Assessment"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="relative z-10 max-w-[90vw] mx-auto px-6 text-center">
      <h2 class="text-sm md:text-base font-semibold tracking-widest uppercase text-cyan-400 mb-4">
        FOR FINANCIAL INSTITUTIONS & LENDERS
      </h2>
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-light mb-8 leading-tight tracking-wide"
      >
        See the Physical Risk <span class="font-bold">Behind the Assets You Finance</span>
      </h1>
      <p
        class="text-xl text-gray-300 font-light leading-relaxed max-w-3xl mx-auto"
      >
        Whether you finance mining operations, infrastructure projects, energy assets or urban developments, physical deterioration can create financial exposure. InSpectiv provides satellite-based ground deformation intelligence to help you assess and monitor the physical condition of financed assets.
      </p>
    </div>
  </section>

  {/* 2. Built for Your Portfolio */}
  <section class="py-16 md:py-24 bg-white border-b border-gray-200">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="mb-16">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
          BUILT FOR YOUR PORTFOLIO
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-gray-50 p-8 border border-gray-100 hover:border-cyan-200 hover:shadow-md transition-all group">
          <i class="bx bx-hard-hat text-3xl text-cyan-600 mb-6 group-hover:scale-110 transition-transform block"></i>
          <h4 class="text-[#000f2c] font-semibold text-lg mb-3">Mining & Resources</h4>
          <p class="text-gray-500 text-sm font-light leading-relaxed">
            Assess deformation around mines, slopes, tailings areas and other critical mining assets.
          </p>
        </div>

        <div class="bg-gray-50 p-8 border border-gray-100 hover:border-cyan-200 hover:shadow-md transition-all group">
          <i class="bx bx-building-house text-3xl text-cyan-600 mb-6 group-hover:scale-110 transition-transform block"></i>
          <h4 class="text-[#000f2c] font-semibold text-lg mb-3">Infrastructure & Construction</h4>
          <p class="text-gray-500 text-sm font-light leading-relaxed">
            Monitor financed roads, bridges, buildings, railways, tunnels and major construction projects.
          </p>
        </div>

        <div class="bg-gray-50 p-8 border border-gray-100 hover:border-cyan-200 hover:shadow-md transition-all group">
          <i class="bx bxs-bolt text-3xl text-cyan-600 mb-6 group-hover:scale-110 transition-transform block"></i>
          <h4 class="text-[#000f2c] font-semibold text-lg mb-3">Energy & Utilities</h4>
          <p class="text-gray-500 text-sm font-light leading-relaxed">
            Assess ground stability around power facilities, pipelines, renewable-energy projects and utility infrastructure.
          </p>
        </div>

        <div class="bg-gray-50 p-8 border border-gray-100 hover:border-cyan-200 hover:shadow-md transition-all group">
          <i class="bx bx-buildings text-3xl text-cyan-600 mb-6 group-hover:scale-110 transition-transform block"></i>
          <h4 class="text-[#000f2c] font-semibold text-lg mb-3">Urban Development</h4>
          <p class="text-gray-500 text-sm font-light leading-relaxed">
            Monitor large real-estate and urban-development projects for subsidence and ground movement.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 3. Key Capabilities */}
  <section class="py-16 md:py-24 bg-slate-50 border-b border-gray-200">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="mb-12">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
          KEY CAPABILITIES
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        <div class="flex items-start gap-4 bg-white p-6 border border-gray-100 rounded-lg">
          <i class="bx bx-search-alt text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
          <p class="text-gray-700 text-sm font-light leading-relaxed">Pre-financing physical-risk assessment</p>
        </div>
        <div class="flex items-start gap-4 bg-white p-6 border border-gray-100 rounded-lg">
          <i class="bx bx-history text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
          <p class="text-gray-700 text-sm font-light leading-relaxed">Historical deformation analysis</p>
        </div>
        <div class="flex items-start gap-4 bg-white p-6 border border-gray-100 rounded-lg">
          <i class="bx bx-radar text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
          <p class="text-gray-700 text-sm font-light leading-relaxed">Independent asset monitoring</p>
        </div>
        <div class="flex items-start gap-4 bg-white p-6 border border-gray-100 rounded-lg">
          <i class="bx bx-grid-alt text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
          <p class="text-gray-700 text-sm font-light leading-relaxed">Portfolio-level risk visibility</p>
        </div>
        <div class="flex items-start gap-4 bg-white p-6 border border-gray-100 rounded-lg">
          <i class="bx bx-line-chart text-2xl text-[#1d4ed8] mt-1 shrink-0"></i>
          <p class="text-gray-700 text-sm font-light leading-relaxed">Ongoing monitoring of financed assets</p>
        </div>
      </div>
    </div>
  </section>

  {/* 4. The Challenge & 5. Our Solution */}
  <section class="py-16 md:py-32 bg-white border-b border-gray-200">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 relative">
        <div
          class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-px bg-gray-200 -translate-x-1/2"
        >
        </div>

        {/* Challenge */}
        <div class="lg:pr-12 flex flex-col">
          <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
            THE CHALLENGE
          </h2>
          <p class="text-gray-600 text-lg font-light leading-relaxed mb-6">
            Financial institutions may have significant exposure to physical assets, but traditional financial and operational reporting does not always reveal emerging ground-related risks.
          </p>
          <p class="text-gray-700 text-lg font-medium italic border-l-4 border-[#1d4ed8] pl-6">
            You need visibility into: Is the asset experiencing deformation, and is that risk changing over time?
          </p>
        </div>

        {/* Solution */}
        <div
          class="lg:pl-12 flex flex-col mt-12 lg:mt-0 pt-12 lg:pt-0 border-t lg:border-t-0 border-gray-200"
        >
          <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
            OUR SOLUTION
          </h2>
          <p class="text-gray-600 text-lg font-light leading-relaxed mb-6">
            InSpectiv provides an independent, satellite-based view of ground deformation around financed assets.
          </p>
          <p class="text-gray-600 text-lg font-light leading-relaxed">
            We help lenders identify historical deformation, understand current movement and monitor changes over time.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 6. What We Monitor */}
  <section class="py-16 md:py-32 bg-gray-50 border-b border-gray-200">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="mb-16">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
          WHAT WE MONITOR
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 border border-gray-100 rounded-lg flex items-start gap-3">
          <span class="text-[#1d4ed8] mt-0.5">✓</span>
          <span class="text-gray-700 text-sm font-light">Subsidence and settlement</span>
        </div>
        <div class="bg-white p-6 border border-gray-100 rounded-lg flex items-start gap-3">
          <span class="text-[#1d4ed8] mt-0.5">✓</span>
          <span class="text-gray-700 text-sm font-light">Slope instability</span>
        </div>
        <div class="bg-white p-6 border border-gray-100 rounded-lg flex items-start gap-3">
          <span class="text-[#1d4ed8] mt-0.5">✓</span>
          <span class="text-gray-700 text-sm font-light">Deformation around critical assets</span>
        </div>
        <div class="bg-white p-6 border border-gray-100 rounded-lg flex items-start gap-3">
          <span class="text-[#1d4ed8] mt-0.5">✓</span>
          <span class="text-gray-700 text-sm font-light">Construction-related movement</span>
        </div>
        <div class="bg-white p-6 border border-gray-100 rounded-lg flex items-start gap-3">
          <span class="text-[#1d4ed8] mt-0.5">✓</span>
          <span class="text-gray-700 text-sm font-light">Persistent deformation zones</span>
        </div>
        <div class="bg-white p-6 border border-gray-100 rounded-lg flex items-start gap-3">
          <span class="text-[#1d4ed8] mt-0.5">✓</span>
          <span class="text-gray-700 text-sm font-light">Changes in deformation patterns</span>
        </div>
        <div class="bg-white p-6 border border-gray-100 rounded-lg flex items-start gap-3">
          <span class="text-[#1d4ed8] mt-0.5">✓</span>
          <span class="text-gray-700 text-sm font-light">Potential physical-risk indicators</span>
        </div>
      </div>
    </div>
  </section>

  {/* 7. How It Works (Timeline) */}
  <section class="py-16 md:py-32 bg-white border-b border-gray-200">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="text-center mb-24">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
          HOW IT WORKS
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-x-8 gap-y-16">
        
        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-1.png" alt="Satellite Data Acquisition" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-1" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-1"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-1">01</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              Satellite Data<br class="hidden lg:block" />Acquisition
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              Historical and current satellite radar data is collected for the asset or project area.
            </p>
          </div>
        </div>

        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-2.png" alt="InSAR Processing" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-2" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-2"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-2">02</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              InSAR<br class="hidden lg:block" />Processing
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              Satellite observations are processed to measure subtle changes in the Earth's surface.
            </p>
          </div>
        </div>

        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-3.png" alt="Deformation Analysis" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-3" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-3"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-3">03</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              Deformation<br class="hidden lg:block" />Analysis
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              We analyse the magnitude, location and evolution of deformation across the asset.
            </p>
          </div>
        </div>

        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-4.png" alt="Risk Alerts & Reporting" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-4" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-4"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-4">04</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              Risk Alerts &<br class="hidden lg:block" />Reporting
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              Significant deformation patterns are translated into clear risk-focused reports and visualisations.
            </p>
          </div>
        </div>

        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-5.png" alt="Informed Decision-Making" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-5" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-5"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-5">05</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              Informed<br class="hidden lg:block" />Decision-Making
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              The insights can support due diligence, project evaluation, portfolio monitoring and risk conversations.
            </p>
          </div>
        </div>

        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-6.png" alt="Continuous Monitoring" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-6" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-6"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-6">06</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              Continuous<br class="hidden lg:block" />Monitoring
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              Regular monitoring provides visibility into whether deformation is stable, increasing or newly emerging.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 8. Sample Insight */}
  <section class="py-16 md:py-24 bg-slate-50 border-b border-gray-200">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="mb-12">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
          SAMPLE INSIGHT
        </h2>
        <h3 class="text-2xl text-gray-800 font-light">
          Asset Deformation Map + Movement Trend
        </h3>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
          <img src="/images/insar_interferogram.png" alt="InSAR Deformation Map" class="w-full h-auto object-cover" />
          <div class="p-4 text-center">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Deformation Map</span>
          </div>
        </div>
        <div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
          <img src="/images/time_series.png" alt="Time-Series Graph" class="w-full h-auto object-cover" />
          <div class="p-4 text-center">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Movement Trend</span>
          </div>
        </div>
      </div>
      <p class="text-gray-600 text-base font-light leading-relaxed mt-8 max-w-3xl">
        Identify deformation hotspots and understand whether movement is stable, persistent or changing over time.
      </p>
    </div>
  </section>

  {/* 9. Business Impact */}
  <section class="py-16 md:py-24 bg-[#000f2c] text-white">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="mb-12">
        <h2 class="text-3xl text-cyan-400 font-normal mb-4 uppercase">
          BUSINESS IMPACT
        </h2>
        <h3 class="text-2xl text-white font-light">
          Improve Visibility into Physical Asset Risk
        </h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="flex items-start gap-4 p-6 border border-white/10 rounded-lg hover:border-cyan-400/30 transition-colors">
          <i class="bx bx-check-circle text-cyan-400 text-xl mt-0.5 shrink-0"></i>
          <span class="text-gray-300 text-sm font-light">Strengthen project due diligence</span>
        </div>
        <div class="flex items-start gap-4 p-6 border border-white/10 rounded-lg hover:border-cyan-400/30 transition-colors">
          <i class="bx bx-check-circle text-cyan-400 text-xl mt-0.5 shrink-0"></i>
          <span class="text-gray-300 text-sm font-light">Identify potential physical-risk indicators</span>
        </div>
        <div class="flex items-start gap-4 p-6 border border-white/10 rounded-lg hover:border-cyan-400/30 transition-colors">
          <i class="bx bx-check-circle text-cyan-400 text-xl mt-0.5 shrink-0"></i>
          <span class="text-gray-300 text-sm font-light">Monitor financed assets remotely</span>
        </div>
        <div class="flex items-start gap-4 p-6 border border-white/10 rounded-lg hover:border-cyan-400/30 transition-colors">
          <i class="bx bx-check-circle text-cyan-400 text-xl mt-0.5 shrink-0"></i>
          <span class="text-gray-300 text-sm font-light">Support portfolio risk assessment</span>
        </div>
        <div class="flex items-start gap-4 p-6 border border-white/10 rounded-lg hover:border-cyan-400/30 transition-colors">
          <i class="bx bx-check-circle text-cyan-400 text-xl mt-0.5 shrink-0"></i>
          <span class="text-gray-300 text-sm font-light">Provide independent evidence alongside traditional assessments</span>
        </div>
        <div class="flex items-start gap-4 p-6 border border-white/10 rounded-lg hover:border-cyan-400/30 transition-colors">
          <i class="bx bx-check-circle text-cyan-400 text-xl mt-0.5 shrink-0"></i>
          <span class="text-gray-300 text-sm font-light">Enable earlier engagement when asset conditions change</span>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  @keyframes trackProgress {
    0%, 100% { width: 0%; opacity: 0; }
    2%, 15% { width: 100%; opacity: 1; }
    16.66% { width: 100%; opacity: 0; }
  }
  .track-1 { animation: trackProgress 18s infinite 0s; }
  .track-2 { animation: trackProgress 18s infinite 3s; }
  .track-3 { animation: trackProgress 18s infinite 6s; }
  .track-4 { animation: trackProgress 18s infinite 9s; }
  .track-5 { animation: trackProgress 18s infinite 12s; }
  .track-6 { animation: trackProgress 18s infinite 15s; }

  @keyframes numProgress {
    0%, 100% { color: rgb(209, 213, 219); } 
    2%, 15% { color: #1d4ed8; }
    16.66% { color: rgb(209, 213, 219); }
  }
  .num-1 { animation: numProgress 18s infinite 0s; }
  .num-2 { animation: numProgress 18s infinite 3s; }
  .num-3 { animation: numProgress 18s infinite 6s; }
  .num-4 { animation: numProgress 18s infinite 9s; }
  .num-5 { animation: numProgress 18s infinite 12s; }
  .num-6 { animation: numProgress 18s infinite 15s; }
  
  @keyframes imgProgress {
    0%, 100% { transform: scale(1); } 
    2%, 15% { transform: scale(1.05); }
    16.66% { transform: scale(1); }
  }
  .img-1 { animation: imgProgress 18s infinite 0s; }
  .img-2 { animation: imgProgress 18s infinite 3s; }
  .img-3 { animation: imgProgress 18s infinite 6s; }
  .img-4 { animation: imgProgress 18s infinite 9s; }
  .img-5 { animation: imgProgress 18s infinite 12s; }
  .img-6 { animation: imgProgress 18s infinite 15s; }
</style>
