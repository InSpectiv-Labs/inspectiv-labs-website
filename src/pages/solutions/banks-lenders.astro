---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Banks & Financial Lenders | InSpectiv Labs"
  description="Zero-Infra Safety Intelligence. Preventing accidents and ensuring DGMS compliance without on-site hardware."
>
  {/* 1. Hero */}
  <section class="relative pt-40 pb-32 bg-[#000f2c] text-white">
    <div class="absolute inset-0 opacity-30">
      <img
        src="/images/satellite_network_mesh.png"
        alt="Banks & Lenders"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="relative z-10 max-w-[90vw] mx-auto px-6 text-center">
      <h2 class="text-sm md:text-base font-semibold tracking-widest uppercase text-cyan-400 mb-4">
        FOR BANKS & LENDERS
      </h2>
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-light mb-8 leading-tight tracking-wide"
      >
        Zero-Infra <span class="font-bold">Safety Intelligence.</span>
      </h1>
      <p
        class="text-xl text-gray-300 font-light leading-relaxed max-w-3xl mx-auto"
      >
        Preventing accidents and ensuring DGMS compliance without on-site
        hardware.
      </p>
    </div>
  </section>

  {/* 2. Challenge vs Solution (Workbench Split) */}
  <section class="py-16 md:py-32 bg-white border-b border-gray-200">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 relative">
        <div
          class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-px bg-gray-200 -translate-x-1/2"
        >
        </div>

        {/* Challenge */}
        <div class="lg:pr-12 flex flex-col">
          <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
            THE CHALLENGE
          </h2>
          <h3 class="text-2xl text-gray-800 font-light mb-8">
            Undetected ground movement can trigger catastrophic failures,
            endanger lives, and halt operations.
          </h3>
          <ul class="pl-8">
            <li
              class="flex flex-col relative pb-8 last:pb-0 before:absolute before:-left-[35px] before:top-2 before:w-1.5 before:h-1.5 before:bg-red-500 before:rounded-full before:z-10 after:absolute after:-left-[32px] after:top-2 after:-bottom-2 after:w-px after:bg-gray-200 last:after:hidden after:z-0"
            >
              <span class="text-[#000f2c] font-semibold text-lg"
                >Slope failures</span
              >
              <span class="text-gray-500 text-sm font-light"
                >and pit wall collapses</span
              >
            </li>
            <li
              class="flex flex-col relative pb-8 last:pb-0 before:absolute before:-left-[35px] before:top-2 before:w-1.5 before:h-1.5 before:bg-red-500 before:rounded-full before:z-10 after:absolute after:-left-[32px] after:top-2 after:-bottom-2 after:w-px after:bg-gray-200 last:after:hidden after:z-0"
            >
              <span class="text-[#000f2c] font-semibold text-lg"
                >Dump instability</span
              >
              <span class="text-gray-500 text-sm font-light"
                >and uncontrolled subsidence</span
              >
            </li>
            <li
              class="flex flex-col relative pb-8 last:pb-0 before:absolute before:-left-[35px] before:top-2 before:w-1.5 before:h-1.5 before:bg-red-500 before:rounded-full before:z-10 after:absolute after:-left-[32px] after:top-2 after:-bottom-2 after:w-px after:bg-gray-200 last:after:hidden after:z-0"
            >
              <span class="text-[#000f2c] font-semibold text-lg"
                >DGMS non-compliance</span
              >
              <span class="text-gray-500 text-sm font-light"
                >regulatory risks and fines</span
              >
            </li>
            <li
              class="flex flex-col relative pb-8 last:pb-0 before:absolute before:-left-[35px] before:top-2 before:w-1.5 before:h-1.5 before:bg-red-500 before:rounded-full before:z-10 after:absolute after:-left-[32px] after:top-2 after:-bottom-2 after:w-px after:bg-gray-200 last:after:hidden after:z-0"
            >
              <span class="text-[#000f2c] font-semibold text-lg"
                >Production delays</span
              >
              <span class="text-gray-500 text-sm font-light"
                >and revenue loss</span
              >
            </li>
          </ul>
        </div>

        {/* Solution */}
        <div
          class="lg:pl-12 flex flex-col mt-12 lg:mt-0 pt-12 lg:pt-0 border-t lg:border-t-0 border-gray-200"
        >
          <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
            OUR SOLUTION
          </h2>
          <h3 class="text-2xl text-gray-800 font-light mb-8">
            InSAR-based monitoring delivers millimeter-level accuracy across
            entire mine sites—frequently and consistently.
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="bg-gray-50 p-6 border border-gray-100 hover:border-cyan-200 hover:shadow-sm transition-all group">
              <i class="bx bx-target-lock text-3xl text-cyan-600 mb-4 group-hover:scale-110 transition-transform"></i>
              <h4 class="text-[#000f2c] font-semibold text-lg mb-1">Detect deformation</h4>
              <p class="text-gray-500 text-sm font-light">As small as 1–2 mm</p>
            </div>
            
            <div class="bg-gray-50 p-6 border border-gray-100 hover:border-cyan-200 hover:shadow-sm transition-all group">
              <i class="bx bx-map-alt text-3xl text-cyan-600 mb-4 group-hover:scale-110 transition-transform"></i>
              <h4 class="text-[#000f2c] font-semibold text-lg mb-1">Wide area coverage</h4>
              <p class="text-gray-500 text-sm font-light">Not just single points</p>
            </div>
            
            <div class="bg-gray-50 p-6 border border-gray-100 hover:border-cyan-200 hover:shadow-sm transition-all group">
              <i class="bx bx-radar text-3xl text-cyan-600 mb-4 group-hover:scale-110 transition-transform"></i>
              <h4 class="text-[#000f2c] font-semibold text-lg mb-1">Frequent revisits</h4>
              <p class="text-gray-500 text-sm font-light">For early detection</p>
            </div>
            
            <div class="bg-gray-50 p-6 border border-gray-100 hover:border-cyan-200 hover:shadow-sm transition-all group">
              <i class="bx bx-history text-3xl text-cyan-600 mb-4 group-hover:scale-110 transition-transform"></i>
              <h4 class="text-[#000f2c] font-semibold text-lg mb-1">Historical time machine</h4>
              <p class="text-gray-500 text-sm font-light">For trend analysis</p>
            </div>
            
            <div class="bg-gray-50 p-6 border border-gray-100 hover:border-cyan-200 hover:shadow-sm transition-all group">
              <i class="bx bx-bell text-3xl text-cyan-600 mb-4 group-hover:scale-110 transition-transform"></i>
              <h4 class="text-[#000f2c] font-semibold text-lg mb-1">Actionable alerts</h4>
              <p class="text-gray-500 text-sm font-light">For faster decisions</p>
            </div>
            
            <div class="bg-gray-50 p-6 border border-gray-100 hover:border-cyan-200 hover:shadow-sm transition-all group">
              <i class="bx bx-wrench text-3xl text-cyan-600 mb-4 group-hover:scale-110 transition-transform"></i>
              <h4 class="text-[#000f2c] font-semibold text-lg mb-1">No on-site hardware</h4>
              <p class="text-gray-500 text-sm font-light">Zero maintenance</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 3. What We Monitor (Grid) */}
  <section class="py-16 md:py-32 bg-gray-50 border-b border-gray-200">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="mb-16">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
          WHAT WE MONITOR
        </h2>
        <h3 class="text-2xl text-gray-800 font-light">
          Comprehensive Site Intelligence
        </h3>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-px bg-gray-200 border border-gray-200"
      >
        <div class="bg-white flex flex-col group overflow-hidden border border-transparent hover:border-[#1d4ed8]/30 transition-all shadow-sm">
          <div class="h-40 overflow-hidden relative shrink-0">
            <img src="/images/geotech_terrain_mesh.png" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-500"></div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
          <i class="bx bx-layer text-3xl text-[#1d4ed8] mb-6"></i>
          <h4
            class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3"
          >
            Open Pit Slopes
          </h4>
          <p class="text-gray-600 text-sm font-light leading-relaxed">
            Monitor highwalls and benches for instability.
          </p>
        </div>
        </div>

        <div class="bg-white flex flex-col group overflow-hidden border border-transparent hover:border-[#1d4ed8]/30 transition-all shadow-sm">
          <div class="h-40 overflow-hidden relative shrink-0">
            <img src="/images/industry_energy.png" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-500"></div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
          <i class="bx bx-water text-3xl text-[#1d4ed8] mb-6"></i>
          <h4
            class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3"
          >
            Tailings Dams
          </h4>
          <p class="text-gray-600 text-sm font-light leading-relaxed">
            Detect deformation and seepage risks for safe operations.
          </p>
        </div>
        </div>

        <div class="bg-white flex flex-col group overflow-hidden border border-transparent hover:border-[#1d4ed8]/30 transition-all shadow-sm">
          <div class="h-40 overflow-hidden relative shrink-0">
            <img src="/images/hero_bg.png" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-500"></div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
          <i class="bx bx-landscape text-3xl text-[#1d4ed8] mb-6"></i>
          <h4
            class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3"
          >
            Waste Dumps
          </h4>
          <p class="text-gray-600 text-sm font-light leading-relaxed">
            Track movement in waste dumps and embankments.
          </p>
        </div>
        </div>

        <div class="bg-white flex flex-col group overflow-hidden border border-transparent hover:border-[#1d4ed8]/30 transition-all shadow-sm">
          <div class="h-40 overflow-hidden relative shrink-0">
            <img src="/images/infrastructure_monitoring.png" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-500"></div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
          <i class="bx bx-buildings text-3xl text-[#1d4ed8] mb-6"></i>
          <h4
            class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3"
          >
            Infrastructure
          </h4>
          <p class="text-gray-600 text-sm font-light leading-relaxed">
            Monitor critical infrastructure for ground risks.
          </p>
        </div>
        </div>

        <div class="bg-white flex flex-col group overflow-hidden border border-transparent hover:border-[#1d4ed8]/30 transition-all shadow-sm">
          <div class="h-40 overflow-hidden relative shrink-0">
            <img src="/images/insar_mine.jpeg" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-500"></div>
          </div>
          <div class="p-6 flex flex-col flex-grow">
          <i class="bx bx-trip text-3xl text-[#1d4ed8] mb-6"></i>
          <h4
            class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3"
          >
            Haul Roads & Ramps
          </h4>
          <p class="text-gray-600 text-sm font-light leading-relaxed">
            Ensure road stability and operational safety.
          </p>
        </div>
        </div>
      </div>
    </div>
  </section>

  {/* 4. How It Works (Timeline) */}
  <section class="py-16 md:py-32 bg-white border-b border-gray-200">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="text-center mb-24">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">
          HOW IT WORKS
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-x-8 gap-y-16">
        
        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-1.png" alt="Satellite Data Acquisition" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-1" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-1"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-1">01</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              Satellite Data<br class="hidden lg:block" />Acquisition
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              We acquire radar data from Sentinel-1 satellites.
            </p>
          </div>
        </div>

        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-2.png" alt="InSAR Processing" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-2" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-2"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-2">02</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              InSAR<br class="hidden lg:block" />Processing
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              Advanced algorithms measure ground deformation.
            </p>
          </div>
        </div>

        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-3.png" alt="Deformation Analysis" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-3" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-3"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-3">03</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              Deformation<br class="hidden lg:block" />Analysis
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              We analyze trends and identify areas of concern.
            </p>
          </div>
        </div>

        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-4.png" alt="Alerts & Reporting" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-4" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-4"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-4">04</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              Alerts &<br class="hidden lg:block" />Reporting
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              Receive alerts and actionable reports with insights.
            </p>
          </div>
        </div>

        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-5.png" alt="Informed Decisions" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-5" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-5"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-5">05</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              Informed<br class="hidden lg:block" />Decisions
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              Take timely actions to mitigate risks and ensure safety.
            </p>
          </div>
        </div>

        <div class="flex flex-col group">
          <div class="aspect-square lg:aspect-[4/5] mb-8 overflow-hidden bg-gray-100 rounded-sm">
            <img src="/images/step-6.png" alt="Continuous Monitoring" class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105 img-6" />
          </div>
          <div class="pt-6 relative border-t border-gray-200 transition-colors duration-300 group-hover:border-transparent">
            <div class="absolute top-[-1px] left-0 w-0 h-[2px] bg-[#1d4ed8] group-hover:w-full transition-all duration-500 ease-out track-6"></div>
            <span class="text-4xl font-light text-gray-300 mb-6 group-hover:text-[#1d4ed8] transition-colors duration-300 block num-6">06</span>
            <h4 class="text-sm font-semibold text-[#000f2c] uppercase tracking-wide mb-3">
              Continuous<br class="hidden lg:block" />Monitoring
            </h4>
            <p class="text-gray-500 text-sm font-light leading-relaxed">
              Ongoing monitoring ensures early detection.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>


</BaseLayout>

<style>
  @keyframes trackProgress {
    0%, 100% { width: 0%; opacity: 0; }
    2%, 15% { width: 100%; opacity: 1; }
    16.66% { width: 100%; opacity: 0; }
  }
  .track-1 { animation: trackProgress 18s infinite 0s; }
  .track-2 { animation: trackProgress 18s infinite 3s; }
  .track-3 { animation: trackProgress 18s infinite 6s; }
  .track-4 { animation: trackProgress 18s infinite 9s; }
  .track-5 { animation: trackProgress 18s infinite 12s; }
  .track-6 { animation: trackProgress 18s infinite 15s; }

  @keyframes numProgress {
    0%, 100% { color: rgb(209, 213, 219); } 
    2%, 15% { color: #1d4ed8; }
    16.66% { color: rgb(209, 213, 219); }
  }
  .num-1 { animation: numProgress 18s infinite 0s; }
  .num-2 { animation: numProgress 18s infinite 3s; }
  .num-3 { animation: numProgress 18s infinite 6s; }
  .num-4 { animation: numProgress 18s infinite 9s; }
  .num-5 { animation: numProgress 18s infinite 12s; }
  .num-6 { animation: numProgress 18s infinite 15s; }
  
  @keyframes imgProgress {
    0%, 100% { transform: scale(1); } 
    2%, 15% { transform: scale(1.05); }
    16.66% { transform: scale(1); }
  }
  .img-1 { animation: imgProgress 18s infinite 0s; }
  .img-2 { animation: imgProgress 18s infinite 3s; }
  .img-3 { animation: imgProgress 18s infinite 6s; }
  .img-4 { animation: imgProgress 18s infinite 9s; }
  .img-5 { animation: imgProgress 18s infinite 12s; }
  .img-6 { animation: imgProgress 18s infinite 15s; }
</style>
