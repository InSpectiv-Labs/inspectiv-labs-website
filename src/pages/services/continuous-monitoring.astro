---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Continuous Ground Deformation Monitoring | InSpectiv"
  description="Receive continuous, real-time alerts on ground subsidence, heave, and instability with our proactive satellite radar monitoring services."
>
  <section class="pt-24 md:pt-32 lg:pt-40 pb-12 md:pb-16 lg:pb-20 bg-[#000f2c] text-white text-center">
    <div class="max-w-[1000px] mx-auto px-4">
      <h1 class="text-3xl md:text-4xl md:text-5xl font-light mb-6 tracking-wide">Continuous Monitoring</h1>
      <p class="text-lg md:text-xl text-gray-300 font-light max-w-2xl mx-auto leading-relaxed">
        Millimeter-scale precision monitoring and automated risk alerts for active operations.
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 lg:py-24 bg-gray-50 min-h-[70vh] flex items-center">
    <div class="max-w-[90vw] mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="flex flex-col">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-[#000f2c] mb-6">Continuous Monitoring</h2>
          <p class="text-gray-600 text-base md:text-lg font-light leading-relaxed mb-10">
            Maintain ongoing visibility of ground movement with satellite-based InSAR monitoring. By analysing successive satellite observations, we track changes in deformation and movement patterns, helping identify emerging risks and significant changes that may require attention.
          </p>
          
          <h3 class="text-lg md:text-xl font-semibold text-[#1d4ed8] mb-6">Key Benefits</h3>
          <ul class="space-y-5">
            <li class="flex items-start gap-3">
              <i class="bx bx-check-circle text-[#1d4ed8] text-lg md:text-xl mt-1 shrink-0"></i>
              <span class="text-gray-700 font-light mt-0.5">Track ground movement continuously across assets and areas of interest.</span>
            </li>
            <li class="flex items-start gap-3">
              <i class="bx bx-check-circle text-[#1d4ed8] text-lg md:text-xl mt-1 shrink-0"></i>
              <span class="text-gray-700 font-light mt-0.5">Detect changes and emerging trends in deformation behaviour.</span>
            </li>
            <li class="flex items-start gap-3">
              <i class="bx bx-check-circle text-[#1d4ed8] text-lg md:text-xl mt-1 shrink-0"></i>
              <span class="text-gray-700 font-light mt-0.5">Identify significant or accelerating movement at an early stage.</span>
            </li>
            <li class="flex items-start gap-3">
              <i class="bx bx-check-circle text-[#1d4ed8] text-lg md:text-xl mt-1 shrink-0"></i>
              <span class="text-gray-700 font-light mt-0.5">Prioritise areas for inspection or intervention based on observed changes.</span>
            </li>
            <li class="flex items-start gap-3">
              <i class="bx bx-check-circle text-[#1d4ed8] text-lg md:text-xl mt-1 shrink-0"></i>
              <span class="text-gray-700 font-light mt-0.5">Support proactive risk management and informed asset-management decisions.</span>
            </li>
          </ul>
        </div>
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-gray-100 group">
          <div class="absolute inset-0 bg-cyan-900/10 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
          <img loading="lazy" 
            src="/images/srv-monitor.webp" 
            alt="Continuous Monitoring Dashboard" 
            class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700 ease-in-out" 
          />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
