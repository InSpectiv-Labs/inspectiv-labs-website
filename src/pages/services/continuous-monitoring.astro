---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Continuous Monitoring | InSpectiv Labs"
  description="Deploy ongoing, millimeter-scale displacement monitoring for active operations and critical infrastructure."
>
  <section class="pt-40 pb-20 bg-[#000f2c] text-white text-center">
    <div class="max-w-[1000px] mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-light mb-6 tracking-wide">Continuous Monitoring</h1>
      <p class="text-xl text-gray-300 font-light max-w-2xl mx-auto leading-relaxed">
        Millimeter-scale precision monitoring and automated risk alerts for active operations.
      </p>
    </div>
  </section>

  <section class="py-24 bg-gray-50 min-h-screen">
    <div class="max-w-[1000px] mx-auto px-6">
      <div class="bg-white p-10 rounded-xl shadow-sm border border-gray-100">
        <h2 class="text-3xl font-semibold text-[#000f2c] mb-6">Real-Time Infrastructure Intelligence</h2>
        <p class="text-gray-600 text-lg font-light leading-relaxed mb-8">
          Deploy ongoing, millimeter-scale displacement monitoring for active operations and critical infrastructure. Our automated systems track structural health and provide early warnings for anomalous movement.
        </p>
        
        <h3 class="text-xl font-semibold text-[#1d4ed8] mb-4">Key Features</h3>
        <ul class="space-y-4 mb-12">
          <li class="flex items-start gap-3">
            <i class="bx bx-check-circle text-[#1d4ed8] text-xl mt-1"></i>
            <div>
              <strong class="block text-gray-900 font-semibold">Millimeter-Scale Precision</strong>
              <span class="text-gray-600 font-light">Identify movement anomalies weeks or months before visible cracking or failure.</span>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bx bx-check-circle text-[#1d4ed8] text-xl mt-1"></i>
            <div>
              <strong class="block text-gray-900 font-semibold">Automated Risk Alerts</strong>
              <span class="text-gray-600 font-light">Receive real-time notifications when ground displacement thresholds are exceeded.</span>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <i class="bx bx-check-circle text-[#1d4ed8] text-xl mt-1"></i>
            <div>
              <strong class="block text-gray-900 font-semibold">Wide-Area Coverage</strong>
              <span class="text-gray-600 font-light">Monitor entire mining sites, pipeline networks, and cities from a single platform.</span>
            </div>
          </li>
        </ul>

        <div class="bg-blue-50 border border-blue-100 rounded-lg p-6">
          <p class="text-sm text-blue-800 italic">
            * This is a scaffolded page. Please update this content with your specific marketing copy and case studies.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
