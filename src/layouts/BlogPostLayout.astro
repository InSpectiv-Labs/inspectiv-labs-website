---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date?: Date;
}

const { title, description, date } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article>
    <h1>{title}</h1>
    {date && <time>{date.toLocaleDateString()}</time>}
    <slot />
  </article>
</BaseLayout>
