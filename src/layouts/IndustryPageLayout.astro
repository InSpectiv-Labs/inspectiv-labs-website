---
import BaseLayout from './BaseLayout.astro';

export interface Challenge {
  title: string;
  description: string;
}

export interface Solution {
  title: string;
  description: string;
}

export interface Props {
  title: string;
  description: string;
  image?: string;
  insarImage?: string;
  graphImage?: string;
  hero: {
    headline: string;
    intro: string;
  };
  industrySlug: string;
  challenges: Challenge[];
  solutions: Solution[];
  benefits: string[];
}

const { title, description, image, insarImage, graphImage, hero, industrySlug, challenges, solutions, benefits } = Astro.props;
---
<BaseLayout title={title} description={description}>
  
  <section class="relative pt-40 pb-32 bg-[#000f2c] text-white">
    {image && (
      <div class="absolute inset-0 opacity-30">
        <img src={image} class="w-full h-full object-cover" />
      </div>
    )}
    <div class="relative z-10 max-w-[95vw] mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-light mb-8 leading-tight tracking-wide">
        {hero.headline}
      </h1>
      <p class="text-xl text-gray-300 font-light leading-relaxed max-w-3xl mx-auto">
        {hero.intro}
      </p>
    </div>
  </section>

  <section class="py-24 bg-gray-50 border-b border-gray-200">
    <div class="max-w-[95vw] mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">VISUAL INTELLIGENCE</h2>
        <h3 class="text-2xl text-gray-800 font-light">From macro context to millimeter precision</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {image && (
          <div class="bg-white border border-gray-100 p-2 shadow-sm rounded-sm">
            <div class="h-64 overflow-hidden relative">
              <img src={image} alt="Site Context" class="w-full h-full object-cover" />
            </div>
            <div class="p-4 text-center">
              <h4 class="text-sm font-semibold text-[#000f2c] uppercase">Site Context</h4>
            </div>
          </div>
        )}
        {(insarImage || "/images/insar_interferogram.png") && (
          <div class="bg-white border border-gray-100 p-2 shadow-sm rounded-sm">
            <div class="h-64 overflow-hidden relative">
              <img src={insarImage || "/images/insar_interferogram.png"} alt="InSAR Analysis" class="w-full h-full object-cover" />
            </div>
            <div class="p-4 text-center">
              <h4 class="text-sm font-semibold text-[#000f2c] uppercase">InSAR Analysis</h4>
            </div>
          </div>
        )}
        {(graphImage || "/images/time_series.png") && (
          <div class="bg-white border border-gray-100 p-2 shadow-sm rounded-sm">
            <div class="h-64 overflow-hidden relative">
              <img src={graphImage || "/images/time_series.png"} alt="Deformation Tracking" class="w-full h-full object-cover" />
            </div>
            <div class="p-4 text-center">
              <h4 class="text-sm font-semibold text-[#000f2c] uppercase">Deformation Tracking</h4>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="py-24 bg-white border-b border-gray-200">
    <div class="max-w-[95vw] mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">THE LANDSCAPE</h2>
        <h3 class="text-2xl text-gray-800 font-light">Key Industry Challenges</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {challenges.map((challenge, index) => (
          <div class="bg-gray-50 border border-gray-100 p-8 shadow-sm hover:shadow-md transition-shadow relative">
            <div class="absolute top-0 left-0 w-full h-1 bg-[#2563eb]"></div>
            <div class="text-4xl font-light text-gray-200 mb-6">0{index + 1}</div>
            <h4 class="text-lg font-semibold text-[#000f2c] uppercase mb-4">{challenge.title}</h4>
            <p class="text-gray-600 text-sm font-light leading-relaxed">{challenge.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-[95vw] mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl text-[#1d4ed8] font-normal mb-4 uppercase">OUR APPROACH</h2>
          <h3 class="text-2xl text-gray-800 font-light mb-6">Tailored Solutions</h3>
          <p class="text-gray-600 text-lg font-light leading-relaxed mb-8">
            InSpectiv Labs delivers proprietary methodologies designed specifically to address the unique complexities of your sector. We deploy targeted services that seamlessly integrate with your existing workflows.
          </p>
          <a href="/contact" class="inline-block px-4 py-3 bg-[#2563eb] text-white text-sm uppercase tracking-wider font-semibold hover:bg-[#1d4ed8] transition-colors shadow-sm">
            Discuss Your Needs
          </a>
        </div>
        <div class="space-y-6">
          {solutions.map((solution, i) => (
            <div class="flex gap-6 p-6 rounded-sm bg-gray-50 border border-gray-100 hover:border-[#1d4ed8] transition-colors group">
              <div class="mt-1 text-[#1d4ed8] shrink-0">
                <i class="bx bx-check-circle text-[24px]"></i>
              </div>
              <div>
                <h4 class="text-lg font-semibold text-[#000f2c] uppercase mb-2 group-hover:text-[#1d4ed8] transition-colors">{solution.title}</h4>
                <p class="text-gray-600 text-sm font-light leading-relaxed">{solution.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-[#000f2c] text-white">
    <div class="max-w-[95vw] mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl text-cyan-400 font-normal mb-4 uppercase">THE IMPACT</h2>
        <h3 class="text-2xl text-white font-light">Business Outcomes</h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center max-w-5xl mx-auto">
        {benefits.map(benefit => (
          <div class="flex flex-col items-center">
            <div class="w-16 h-16 rounded-full bg-white/10 flex items-center justify-center mb-6 text-cyan-400 border border-white/20">
              <i class="bx bx-trending-up text-[24px]"></i>
            </div>
            <p class="text-lg font-light text-gray-200 leading-relaxed">{benefit}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <section class="py-32 bg-white text-center">
    <div class="max-w-[95vw] mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-light text-[#000f2c] mb-6">Ready to secure your operations?</h2>
      <p class="text-xl text-gray-600 font-light max-w-2xl mx-auto mb-10">
        Speak directly with our  specialists about your specific challenges and how InSpectiv Labs can help.
      </p>
      <a href="/contact" class="inline-block px-10 py-4 bg-[#2563eb] text-white text-sm uppercase tracking-wider font-semibold hover:bg-[#1d4ed8] transition-colors shadow-sm">
        Talk to an Expert
      </a>
    </div>
  </section>
  
</BaseLayout>
