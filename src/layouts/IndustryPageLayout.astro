---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';

export interface Challenge {
  title: string;
  description: string;
}

export interface Solution {
  title: string;
  description: string;
}

export interface Props {
  title: string;
  description: string;
  hero: {
    headline: string;
    intro: string;
  };
  industrySlug: string;
  challenges: Challenge[];
  solutions: Solution[];
  benefits: string[];
}

const { title, description, hero, industrySlug, challenges, solutions, benefits } = Astro.props;
---
<BaseLayout title={title} description={description}>
  
  {/* 1. Hero */}
  <section class="relative pt-32 pb-24 bg-slate-900 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-primary-500 via-slate-900 to-slate-900"></div>
    <Container className="relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 mb-6">
          <span class="text-sm font-medium tracking-wide text-secondary-400">Industry Solutions</span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6 leading-tight">
          {hero.headline}
        </h1>
        <p class="text-xl text-slate-300 font-light leading-relaxed">
          {hero.intro}
        </p>
      </div>
    </Container>
  </section>

  {/* 2. Challenges */}
  <section class="py-24 bg-slate-50">
    <Container>
      <SectionHeading 
        eyebrow="The Landscape"
        title="Key Industry Challenges" 
        className="mb-12"
      />
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {challenges.map((challenge, index) => (
          <Card title={challenge.title} description={challenge.description}>
             <div class="absolute top-6 right-6 text-slate-200 font-heading font-bold text-4xl opacity-50">
               0{index + 1}
             </div>
          </Card>
        ))}
      </div>
    </Container>
  </section>

  {/* 3. Solutions */}
  <section class="py-24 bg-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <SectionHeading 
            eyebrow="Our Approach"
            title="Tailored Solutions" 
            description="Inspective Labs delivers proprietary methodologies designed specifically to address the unique complexities of your sector."
          />
        </div>
        <div class="space-y-6">
          {solutions.map(solution => (
            <div class="flex gap-4 p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:shadow-md transition-shadow">
              <div class="mt-1 text-primary-600 shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div>
                <h3 class="text-xl font-heading font-bold text-slate-900 mb-2">{solution.title}</h3>
                <p class="text-slate-600">{solution.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  {/* 4. Benefits */}
  <section class="py-24 bg-slate-900 text-white">
    <Container>
      <SectionHeading 
        eyebrow="The Impact"
        title="Business Outcomes" 
        alignment="center"
        className="mb-16"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center max-w-4xl mx-auto">
        {benefits.map(benefit => (
          <div class="p-6">
            <div class="w-12 h-12 bg-slate-800 text-secondary-400 rounded-full flex items-center justify-center mx-auto mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
            </div>
            <p class="text-lg font-medium text-slate-200">{benefit}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  {/* 5. Case Studies Placeholder */}
  <section class="py-24 bg-slate-50">
    <Container>
      <SectionHeading 
        eyebrow="Proven Success"
        title="Case Studies" 
        className="mb-12"
      />
      <div class="p-12 border-2 border-dashed border-slate-300 rounded-2xl text-center bg-slate-100">
        <svg class="w-12 h-12 text-slate-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
        <h3 class="text-xl font-heading font-bold text-slate-700 mb-2">Industry Case Studies Coming Soon</h3>
        <p class="text-slate-500 max-w-lg mx-auto">We are currently compiling comprehensive case studies detailing our specific impact in this sector. Check back shortly for detailed success stories.</p>
      </div>
    </Container>
  </section>

  {/* 6. CTA */}
  <section class="py-24 bg-white text-center border-t border-slate-100">
    <Container>
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-6">Ready to secure your operations?</h2>
      <p class="text-xl text-slate-600 max-w-2xl mx-auto mb-10">
        Speak directly with our {hero.headline.split(' ').pop()} specialists about your specific challenges.
      </p>
      <Button variant="primary" size="lg" href={`/contact?industry=${industrySlug}`}>Talk to an Expert</Button>
    </Container>
  </section>
  
</BaseLayout>
