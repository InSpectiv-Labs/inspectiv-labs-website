{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/admin(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/imagekit-auth/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/imagekit-delete/?$",
			"dest": "_render"
		},
		{
			"src": "^/case-studies/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/case-studies/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/industries/energy/?$",
			"dest": "_render"
		},
		{
			"src": "^/industries/infrastructure/?$",
			"dest": "_render"
		},
		{
			"src": "^/industries/mining/?$",
			"dest": "_render"
		},
		{
			"src": "^/industries/urban-development/?$",
			"dest": "_render"
		},
		{
			"src": "^/insights/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/insights/?$",
			"dest": "_render"
		},
		{
			"src": "^/privacy-policy/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/continuous-monitoring/?$",
			"dest": "_render"
		},
		{
			"src": "^/services/historical-analysis/?$",
			"dest": "_render"
		},
		{
			"src": "^/solutions/asset-owners-operators/?$",
			"dest": "_render"
		},
		{
			"src": "^/solutions/engineering-geotech-consultants/?$",
			"dest": "_render"
		},
		{
			"src": "^/solutions/financial-institutions-lenders/?$",
			"dest": "_render"
		},
		{
			"src": "^/solutions/insurance-risk-professionals/?$",
			"dest": "_render"
		},
		{
			"src": "^/technology/?$",
			"dest": "_render"
		},
		{
			"src": "^/terms/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}